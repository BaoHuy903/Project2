<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <!-- Google Fonts & Icons -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #f8fafc;
      color: #1e293b;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .login-container {
      width: 100%;
      max-width: 400px;
      padding: 20px;
    }
    .login-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 36px 30px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.02);
    }
    .logo-area {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-bottom: 28px;
    }
    .logo-icon {
      font-size: 2.2rem;
      color: #1e3a8a;
      margin-bottom: 8px;
    }
    .form-control-custom {
      background: #ffffff;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      color: #0f172a;
      padding: 10px 40px 10px 40px;
      font-size: 0.95rem;
      transition: all 0.15s ease-in-out;
    }
    .form-control-custom:focus {
      background: #ffffff;
      border-color: #2563eb;
      box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
      color: #0f172a;
    }
    .input-group-custom {
      position: relative;
      margin-bottom: 18px;
    }
    .input-group-custom .input-icon {
      position: absolute;
      left: 14px;
      top: 22px;
      transform: translateY(-50%);
      color: #64748b;
      font-size: 1rem;
      z-index: 10;
      transition: color 0.15s;
    }
    .input-group-custom:focus-within .input-icon {
      color: #2563eb;
    }
    .input-group-custom .eye-toggle {
      position: absolute;
      right: 14px;
      top: 22px;
      transform: translateY(-50%);
      color: #64748b;
      cursor: pointer;
      z-index: 10;
      font-size: 1rem;
    }
    .input-group-custom .eye-toggle:hover {
      color: #2563eb;
    }
    .btn-submit {
      background-color: #1e3a8a;
      border: 1px solid #1e3a8a;
      border-radius: 8px;
      padding: 12px;
      font-weight: 600;
      font-size: 0.95rem;
      color: white;
      transition: all 0.15s ease-in-out;
    }
    .btn-submit:hover {
      background-color: #1e40af;
      border-color: #1e40af;
    }
    .btn-submit:active {
      transform: translateY(1px);
    }
    .form-label {
      font-size: 0.88rem;
      color: #475569;
      margin-bottom: 6px;
      font-weight: 500;
    }
    .alert-custom {
      background: #fef2f2;
      border: 1px solid #fee2e2;
      color: #991b1b;
      border-radius: 8px;
      padding: 10px 14px;
      font-size: 0.88rem;
    }
    /* Disable Bootstrap validation checkmarks and green borders */
    .was-validated .form-control:valid, 
    .was-validated .form-control-custom:valid {
      border-color: #cbd5e1 !important;
      background-image: none !important;
      padding-right: 14px !important;
    }
    .was-validated .form-control:valid:focus,
    .was-validated .form-control-custom:valid:focus {
      border-color: #2563eb !important;
      box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1) !important;
    }
    .was-validated .form-control:invalid, 
    .was-validated .form-control-custom:invalid {
      background-image: none !important;
      border-color: #ef4444 !important;
    }
  </style>
</head>
<body>

<div class="login-container">
  <div class="login-card">
    <div class="logo-area">
      <i class="bi bi-house-door logo-icon"></i>
      <h4 class="fw-bold mb-1 text-dark">TRỌ VÍP</h4>
      <p class="text-secondary small mb-0">Đăng nhập tài khoản của bạn</p>
    </div>

    <!-- Error Alert -->
    <% if (error) { %>
      <div class="alert alert-custom alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-exclamation-circle-fill me-2"></i> <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" style="font-size:0.75rem; padding: 1.15rem;"></button>
      </div>
    <% } %>

    <form id="loginForm" method="POST" action="/users/login" class="needs-validation" novalidate>
      <!-- Username -->
      <div class="mb-3">
        <label class="form-label">Tài khoản</label>
        <div class="input-group-custom">
          <i class="bi bi-person input-icon"></i>
          <input type="text" name="username" class="form-control form-control-custom w-100" placeholder="Nhập tên tài khoản..." required minlength="3" autocomplete="username">
          <div class="invalid-feedback text-danger small mt-1">Vui lòng nhập tài khoản (tối thiểu 3 ký tự).</div>
        </div>
      </div>

      <!-- Password -->
      <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center mb-1">
          <label class="form-label mb-0">Mật khẩu</label>
          <a href="/users/forgot-password" class="text-decoration-none small" style="color: #2563eb; font-size: 0.82rem;">Quên mật khẩu?</a>
        </div>
        <div class="input-group-custom">
          <i class="bi bi-lock input-icon"></i>
          <input type="password" id="password" name="password" class="form-control form-control-custom w-100" placeholder="Nhập mật khẩu..." required minlength="6" autocomplete="current-password">
          <i id="eyeIcon" class="bi bi-eye eye-toggle" onclick="togglePassword()"></i>
          <div class="invalid-feedback text-danger small mt-1">Vui lòng nhập mật khẩu (tối thiểu 6 ký tự).</div>
        </div>
      </div>

      <!-- Button -->
      <div class="d-grid mb-3">
        <button type="submit" class="btn btn-submit">
          Đăng nhập <i class="bi bi-arrow-right-short ms-1 fs-5 align-middle"></i>
        </button>
      </div>
    </form>

    <hr style="border-color: #e2e8f0; margin: 20px 0;">

    <p class="text-center mb-0 text-secondary small">
      Chưa có tài khoản?
      <a href="/users/register" class="fw-bold text-decoration-none" style="color: #2563eb">Đăng ký ngay</a>
    </p>
  </div>
</div>

<!-- Toast -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1050;">
  <div id="regToast" class="toast align-items-center text-bg-success border-0 rounded-4" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="4000">
    <div class="d-flex p-2">
      <div class="toast-body d-flex align-items-center">
        <i class="bi bi-check-circle-fill fs-5 me-2"></i>
        <span>Đăng ký thành công! Vui lòng đăng nhập tài khoản.</span>
      </div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  // Show / Hide password
  function togglePassword() {
    const password = document.getElementById("password");
    const icon = document.getElementById("eyeIcon");
    if (password.type === "password") {
      password.type = "text";
      icon.classList.remove("bi-eye");
      icon.classList.add("bi-eye-slash");
    } else {
      password.type = "password";
      icon.classList.remove("bi-eye-slash");
      icon.classList.add("bi-eye");
    }
  }

  // Check query params for registration success toast
  window.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('registered')) {
      const toastEl = document.getElementById('regToast');
      const toast = new bootstrap.Toast(toastEl);
      toast.show();
      // clean query params in history without reloading page
      const newurl = window.location.protocol + "//" + window.location.host + window.location.pathname;
      window.history.pushState({path:newurl},'',newurl);
    }
  });

  // Client-side validation bootstrap
  (() => {
    'use strict'
    const forms = document.querySelectorAll('.needs-validation')
    Array.from(forms).forEach(form => {
      form.addEventListener('submit', event => {
        if (!form.checkValidity()) {
          event.preventDefault()
          event.stopPropagation()
        }
        form.classList.add('was-validated')
      }, false)
    })
  })()
</script>
</body>
</html>