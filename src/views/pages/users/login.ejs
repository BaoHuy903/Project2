<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/design-system.css">
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body>

<div class="auth-wrapper w-100">
  <!-- Sidebar Panel (Desktop only) -->
  <div class="auth-sidebar d-none d-lg-flex">
    <a href="/" class="auth-sidebar-brand">
      <i class="bi bi-house-door-fill"></i> TrọVíp
    </a>
    <div class="auth-sidebar-content">
      <h1 class="auth-sidebar-title">Tìm kiếm căn phòng mơ ước tiếp theo</h1>
      <p class="auth-sidebar-desc">
        Hàng ngàn phòng trọ chất lượng, giá tốt tại Đà Nẵng đang chờ bạn khám phá. Đăng nhập ngay để lưu tin và liên hệ trực tiếp chủ trọ.
      </p>
    </div>
    <div class="auth-sidebar-footer">
      &copy; 2026 TrọVíp.
    </div>
  </div>

  <!-- Form Panel -->
  <div class="auth-main">
    <div class="auth-main-header">
      <a href="/" class="auth-brand-mobile d-inline-flex d-lg-none">
        <i class="bi bi-house-door-fill"></i> TrọVíp
      </a>
      <h2 class="auth-title">Chào mừng trở lại</h2>
      <p class="auth-subtitle">Nhập thông tin tài khoản của bạn để đăng nhập</p>
    </div>

    <!-- Error Alert -->
    <% if (error) { %>
      <div class="alert alert-danger border-0 rounded-3 d-flex align-items-center mb-4" role="alert" style="background-color: var(--color-danger-bg); color: var(--color-danger-text);">
        <i class="bi bi-exclamation-circle-fill me-2 fs-5"></i>
        <div class="small fw-medium"><%= error %></div>
      </div>
    <% } %>

    <form id="loginForm" method="POST" action="/users/login" class="needs-validation" novalidate>
      <!-- Username -->
      <div class="mb-3">
        <label class="form-label fw-semibold text-secondary small mb-2">Tài khoản</label>
        <div class="auth-input-wrapper">
          <i class="bi bi-person input-icon"></i>
          <input type="text" name="username" class="input-tv w-100" placeholder="Nhập tên tài khoản..." required minlength="3" autocomplete="username">
          <div class="invalid-feedback text-danger small mt-1">Vui lòng nhập tài khoản (tối thiểu 3 ký tự).</div>
        </div>
      </div>

      <!-- Password -->
      <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <label class="form-label fw-semibold text-secondary small mb-0">Mật khẩu</label>
          <a href="/users/forgot-password" class="text-decoration-none small text-primary fw-medium" style="font-size: 0.8rem;">Quên mật khẩu?</a>
        </div>
        <div class="auth-input-wrapper">
          <i class="bi bi-lock input-icon"></i>
          <input type="password" id="password" name="password" class="input-tv w-100" placeholder="Nhập mật khẩu..." required minlength="6" autocomplete="current-password">
          <i id="eyeIcon" class="bi bi-eye eye-toggle" onclick="togglePassword()"></i>
          <div class="invalid-feedback text-danger small mt-1">Vui lòng nhập mật khẩu (tối thiểu 6 ký tự).</div>
        </div>
      </div>

      <!-- Button -->
      <div class="d-grid mb-4">
        <button type="submit" class="btn-tv btn-tv-primary btn-tv-lg w-100">
          Đăng nhập <i class="bi bi-arrow-right ms-2"></i>
        </button>
      </div>
    </form>

    <hr style="border-color: var(--color-border); margin: var(--space-6) 0;">

    <p class="text-center mb-0 text-secondary small">
      Chưa có tài khoản?
      <a href="/users/register" class="fw-bold text-decoration-none text-primary">Đăng ký ngay</a>
    </p>
  </div>
</div>

<!-- Toast -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1060;">
  <div id="regToast" class="toast align-items-center border-0 rounded-3 toast-tv text-bg-success" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="5000">
    <div class="d-flex p-2">
      <div class="toast-body d-flex align-items-center">
        <i class="bi bi-check-circle-fill fs-5 me-2"></i>
        <span>Đăng ký thành công! Vui lòng đăng nhập tài khoản.</span>
      </div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  // Show / Hide password
  function togglePassword() {
    const password = document.getElementById("password");
    const icon = document.getElementById("eyeIcon");
    if (password.type === "password") {
      password.type = "text";
      icon.classList.remove("bi-eye");
      icon.classList.add("bi-eye-slash");
    } else {
      password.type = "password";
      icon.classList.remove("bi-eye-slash");
      icon.classList.add("bi-eye");
    }
  }

  // Check query params for registration success toast
  window.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('registered')) {
      const toastEl = document.getElementById('regToast');
      const toast = new bootstrap.Toast(toastEl);
      toast.show();
      const newurl = window.location.protocol + "//" + window.location.host + window.location.pathname;
      window.history.pushState({path:newurl},'',newurl);
    }
  });

  // Client-side validation bootstrap
  (() => {
    'use strict'
    const forms = document.querySelectorAll('.needs-validation')
    Array.from(forms).forEach(form => {
      form.addEventListener('submit', event => {
        if (!form.checkValidity()) {
          event.preventDefault()
          event.stopPropagation()
        }
        form.classList.add('was-validated')
      }, false)
    })
  })()
</script>
</body>
</html>