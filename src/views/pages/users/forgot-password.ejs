<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <!-- Google Fonts & Icons -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #f8fafc;
      color: #1e293b;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .forgot-container {
      width: 100%;
      max-width: 420px;
      padding: 20px;
    }
    .forgot-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 36px 30px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.02);
    }
    .logo-area {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-bottom: 28px;
    }
    .logo-icon {
      font-size: 2.2rem;
      color: #1e3a8a;
      margin-bottom: 8px;
    }
    .form-control-custom {
      background: #ffffff;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      color: #0f172a;
      padding: 10px 40px 10px 40px;
      font-size: 0.95rem;
      transition: all 0.15s ease-in-out;
    }
    .form-control-custom:focus {
      background: #ffffff;
      border-color: #2563eb;
      box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
      color: #0f172a;
    }
    .input-group-custom {
      position: relative;
      margin-bottom: 12px;
    }
    .input-group-custom .input-icon {
      position: absolute;
      left: 14px;
      top: 22px;
      transform: translateY(-50%);
      color: #64748b;
      font-size: 1rem;
      z-index: 10;
      transition: color 0.15s;
    }
    .input-group-custom:focus-within .input-icon {
      color: #2563eb;
    }
    .input-group-custom .eye-toggle {
      position: absolute;
      right: 14px;
      top: 22px;
      transform: translateY(-50%);
      color: #64748b;
      cursor: pointer;
      z-index: 10;
      font-size: 1rem;
    }
    .input-group-custom .eye-toggle:hover {
      color: #2563eb;
    }
    .btn-submit {
      background-color: #1e3a8a;
      border: 1px solid #1e3a8a;
      border-radius: 8px;
      padding: 12px;
      font-weight: 600;
      font-size: 0.95rem;
      color: white;
      transition: all 0.15s ease-in-out;
    }
    .btn-submit:hover {
      background-color: #1e40af;
      border-color: #1e40af;
    }
    .btn-submit:active {
      transform: translateY(1px);
    }
    .form-label {
      font-size: 0.88rem;
      color: #475569;
      margin-bottom: 6px;
      font-weight: 500;
    }
    .alert-custom-danger {
      background: #fef2f2;
      border: 1px solid #fee2e2;
      color: #991b1b;
      border-radius: 8px;
      padding: 10px 14px;
      font-size: 0.88rem;
    }
    .alert-custom-success {
      background: #f0fdf4;
      border: 1px solid #dcfce7;
      color: #166534;
      border-radius: 8px;
      padding: 10px 14px;
      font-size: 0.88rem;
    }
    .req-list {
      font-size: 0.8rem;
      color: #64748b;
      list-style-type: none;
      padding-left: 0;
      margin-top: 5px;
      margin-bottom: 20px;
    }
    .req-list li {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 4px;
    }
    .req-list li.valid {
      color: #16a34a;
    }
    .req-list li.invalid {
      color: #dc2626;
    }
    .was-validated .form-control:valid, 
    .was-validated .form-control-custom:valid {
      border-color: #cbd5e1 !important;
      background-image: none !important;
      padding-right: 14px !important;
    }
    .was-validated .form-control:valid:focus,
    .was-validated .form-control-custom:valid:focus {
      border-color: #2563eb !important;
      box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1) !important;
    }
    .was-validated .form-control:invalid, 
    .was-validated .form-control-custom:invalid {
      background-image: none !important;
      border-color: #ef4444 !important;
    }
  </style>
</head>
<body>

<div class="forgot-container">
  <div class="mb-3">
    <a href="/users/login" class="btn btn-sm btn-outline-secondary rounded-pill px-3" style="font-size:0.8rem;">
      <i class="bi bi-arrow-left"></i> Quay lại Đăng nhập
    </a>
  </div>

  <div class="forgot-card">
    <div class="logo-area">
      <i class="bi bi-question-circle logo-icon"></i>
      <h4 class="fw-bold mb-1 text-dark">QUÊN MẬT KHẨU</h4>
      <p class="text-secondary small mb-0">Khôi phục mật khẩu tài khoản của bạn</p>
    </div>

    <!-- Alerts -->
    <% if (error) { %>
      <div class="alert alert-custom-danger alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-exclamation-circle-fill me-2"></i> <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" style="font-size:0.75rem; padding: 1.15rem;"></button>
      </div>
    <% } %>

    <% if (success) { %>
      <div class="alert alert-custom-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" style="font-size:0.75rem; padding: 1.15rem;"></button>
      </div>
    <% } %>

    <form id="forgotForm" method="POST" action="/users/forgot-password" class="needs-validation" novalidate>
      <!-- Username -->
      <div class="mb-3">
        <label class="form-label">Tên tài khoản</label>
        <div class="input-group-custom">
          <i class="bi bi-person-fill input-icon"></i>
          <input type="text" id="username" name="username" class="form-control form-control-custom w-100" placeholder="Nhập tên tài khoản..." required autocomplete="username">
          <div class="invalid-feedback text-danger small mt-1">Vui lòng nhập tên tài khoản cần khôi phục.</div>
        </div>
      </div>

      <!-- New Password -->
      <div class="mb-2">
        <label class="form-label">Mật khẩu mới</label>
        <div class="input-group-custom">
          <i class="bi bi-key-fill input-icon"></i>
          <input type="password" id="password" name="newPassword" class="form-control form-control-custom w-100" placeholder="Nhập mật khẩu mới..." required autocomplete="new-password">
          <i id="eyeIconNew" class="bi bi-eye eye-toggle" onclick="togglePassword('password', 'eyeIconNew')"></i>
          <div class="invalid-feedback text-danger small mt-1">Mật khẩu mới không hợp lệ.</div>
        </div>
      </div>

      <!-- Password Requirements -->
      <ul class="req-list" id="passwordReqs">
        <li id="reqLength" class="invalid"><i class="bi bi-x-circle-fill"></i> Tối thiểu 6 ký tự</li>
        <li id="reqAlphaNum" class="invalid"><i class="bi bi-x-circle-fill"></i> Chứa cả chữ cái và chữ số</li>
      </ul>

      <!-- Confirm Password -->
      <div class="mb-4">
        <label class="form-label">Xác nhận mật khẩu mới</label>
        <div class="input-group-custom">
          <i class="bi bi-patch-check-fill input-icon"></i>
          <input type="password" id="confirmPassword" name="confirmPassword" class="form-control form-control-custom w-100" placeholder="Nhập lại mật khẩu mới..." required autocomplete="new-password">
          <i id="eyeIconConfirm" class="bi bi-eye eye-toggle" onclick="togglePassword('confirmPassword', 'eyeIconConfirm')"></i>
          <div class="invalid-feedback text-danger small mt-1" id="confirmFeedback">Xác nhận mật khẩu mới không khớp.</div>
        </div>
      </div>

      <!-- Button -->
      <div class="d-grid">
        <button type="submit" class="btn btn-submit" id="btnSubmit">
          Khôi phục mật khẩu <i class="bi bi-arrow-right-short ms-1 fs-5 align-middle"></i>
        </button>
      </div>
    </form>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  // Show / Hide password
  function togglePassword(inputId, iconId) {
    const input = document.getElementById(inputId);
    const icon = document.getElementById(iconId);
    if (input.type === "password") {
      input.type = "text";
      icon.classList.remove("bi-eye");
      icon.classList.add("bi-eye-slash");
    } else {
      input.type = "password";
      icon.classList.remove("bi-eye-slash");
      icon.classList.add("bi-eye");
    }
  }

  // Real-time Password Strength Check
  const passwordInput = document.getElementById('password');
  const reqLength = document.getElementById('reqLength');
  const reqAlphaNum = document.getElementById('reqAlphaNum');

  passwordInput.addEventListener('input', () => {
    const val = passwordInput.value;
    const hasLetter = /[a-zA-Z]/.test(val);
    const hasNumber = /[0-9]/.test(val);
    
    // Check length
    if (val.length >= 6) {
      reqLength.classList.remove('invalid');
      reqLength.classList.add('valid');
      reqLength.querySelector('i').className = 'bi bi-check-circle-fill';
    } else {
      reqLength.classList.remove('valid');
      reqLength.classList.add('invalid');
      reqLength.querySelector('i').className = 'bi bi-x-circle-fill';
    }

    // Check letter & number
    if (hasLetter && hasNumber) {
      reqAlphaNum.classList.remove('invalid');
      reqAlphaNum.classList.add('valid');
      reqAlphaNum.querySelector('i').className = 'bi bi-check-circle-fill';
    } else {
      reqAlphaNum.classList.remove('valid');
      reqAlphaNum.classList.add('invalid');
      reqAlphaNum.querySelector('i').className = 'bi bi-x-circle-fill';
    }

    // Set validity
    if (val.length >= 6 && hasLetter && hasNumber) {
      passwordInput.setCustomValidity('');
    } else {
      passwordInput.setCustomValidity('Weak password');
    }
  });

  // Real-time match validation
  const confirmInput = document.getElementById('confirmPassword');
  const confirmFeedback = document.getElementById('confirmFeedback');
  
  function validateConfirm() {
    if (confirmInput.value !== passwordInput.value) {
      confirmInput.setCustomValidity('Mismatch');
      confirmFeedback.textContent = 'Xác nhận mật khẩu mới không khớp.';
    } else {
      confirmInput.setCustomValidity('');
    }
  }
  
  confirmInput.addEventListener('input', validateConfirm);
  passwordInput.addEventListener('input', validateConfirm);

  // Client-side validation bootstrap
  (() => {
    'use strict'
    const forms = document.querySelectorAll('.needs-validation')
    Array.from(forms).forEach(form => {
      form.addEventListener('submit', event => {
        // Trigger manual validate checks
        passwordInput.dispatchEvent(new Event('input'));
        confirmInput.dispatchEvent(new Event('input'));

        if (!form.checkValidity()) {
          event.preventDefault()
          event.stopPropagation()
        }
        form.classList.add('was-validated')
      }, false)
    })
  })()
</script>
</body>
</html>
