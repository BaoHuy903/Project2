<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/design-system.css">
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body>

<div class="auth-wrapper w-100">
  <!-- Sidebar Panel (Desktop only) -->
  <div class="auth-sidebar d-none d-lg-flex">
    <a href="/" class="auth-sidebar-brand">
      <i class="bi bi-house-door-fill"></i> TrọVíp
    </a>
    <div class="auth-sidebar-content">
      <h1 class="auth-sidebar-title">Tìm kiếm căn phòng mơ ước tiếp theo</h1>
      <p class="auth-sidebar-desc">
        Hàng ngàn phòng trọ chất lượng, giá tốt tại Đà Nẵng đang chờ bạn khám phá. Đăng ký ngay để bắt đầu hành trình của bạn.
      </p>
    </div>
    <div class="auth-sidebar-footer">
      &copy; 2026 TrọVíp.
    </div>
  </div>

  <!-- Form Panel -->
  <div class="auth-main">
    <div class="auth-main-header">
      <a href="/" class="auth-brand-mobile d-inline-flex d-lg-none">
        <i class="bi bi-house-door-fill"></i> TrọVíp
      </a>
      <h2 class="auth-title">Đăng ký tài khoản</h2>
      <p class="auth-subtitle">Nhập thông tin tài khoản mới của bạn để bắt đầu</p>
    </div>

    <!-- Error Alert -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger border-0 rounded-3 d-flex align-items-center mb-4" role="alert" style="background-color: var(--color-danger-bg); color: var(--color-danger-text);">
        <i class="bi bi-exclamation-circle-fill me-2 fs-5"></i>
        <div class="small fw-medium"><%= error %></div>
      </div>
    <% } %>

    <form id="registerForm" method="POST" action="/users/register" class="needs-validation" novalidate>
      <!-- Username -->
      <div class="mb-3">
        <label class="form-label fw-semibold text-secondary small mb-2">Tài khoản</label>
        <div class="auth-input-wrapper">
          <i class="bi bi-person input-icon"></i>
          <input type="text" id="username" name="username" class="input-tv w-100" placeholder="Chỉ chứa chữ và số, không khoảng trắng" required minlength="3" autocomplete="username">
          <div class="invalid-feedback text-danger small mt-1" id="usernameFeedback">Tài khoản phải dài tối thiểu 3 ký tự.</div>
        </div>
      </div>

      <!-- Password -->
      <div class="mb-2">
        <label class="form-label fw-semibold text-secondary small mb-2">Mật khẩu</label>
        <div class="auth-input-wrapper">
          <i class="bi bi-lock input-icon"></i>
          <input type="password" id="password" name="password" class="input-tv w-100" placeholder="Nhập mật khẩu..." required autocomplete="new-password">
          <i id="eyeIcon" class="bi bi-eye eye-toggle" onclick="togglePassword()"></i>
          <div class="invalid-feedback text-danger small mt-1">Mật khẩu không hợp lệ.</div>
        </div>
      </div>

      <!-- Password Requirements -->
      <ul class="req-list" id="passwordReqs">
        <li id="reqLength" class="invalid"><i class="bi bi-x-circle-fill"></i> Tối thiểu 6 ký tự</li>
        <li id="reqAlphaNum" class="invalid"><i class="bi bi-x-circle-fill"></i> Chứa cả chữ cái và chữ số</li>
      </ul>

      <!-- Role Selection -->
      <div class="mb-4">
        <label class="form-label fw-semibold text-secondary small d-block text-start mb-2">Vai trò của bạn</label>
        <div class="row g-3" id="roleCards">
          <div class="col-6">
            <div class="role-card border rounded p-3 text-center cursor-pointer h-100" data-role="TENANT" onclick="selectRole('TENANT')">
              <i class="bi bi-house-heart fs-3 mb-2 d-block text-secondary" id="icon-tenant"></i>
              <span class="fw-semibold d-block text-dark" style="font-size: 0.9rem;">Khách thuê</span>
              <small class="text-muted d-block" style="font-size: 0.72rem; line-height: 1.2;">Tìm kiếm và xem phòng trọ</small>
            </div>
          </div>
          <div class="col-6">
            <div class="role-card border rounded p-3 text-center cursor-pointer h-100" data-role="LANDLORD" onclick="selectRole('LANDLORD')">
              <i class="bi bi-building-up fs-3 mb-2 d-block text-secondary" id="icon-landlord"></i>
              <span class="fw-semibold d-block text-dark" style="font-size: 0.9rem;">Chủ trọ</span>
              <small class="text-muted d-block" style="font-size: 0.72rem; line-height: 1.2;">Đăng tin cho thuê phòng</small>
            </div>
          </div>
        </div>
        <input type="hidden" id="selectedRole" name="role" required>
        <div class="text-danger small mt-2 d-none" id="roleFeedback" style="font-size: 0.8rem;">
          <i class="bi bi-exclamation-circle-fill me-1"></i> Vui lòng chọn vai trò của bạn trước khi đăng ký.
        </div>
      </div>

      <!-- Button -->
      <div class="d-grid mb-3">
        <button type="submit" class="btn-tv btn-tv-primary btn-tv-lg w-100" id="btnSubmit">
          Đăng ký <i class="bi bi-check-circle ms-2"></i>
        </button>
      </div>
    </form>

    <hr style="border-color: var(--color-border); margin: var(--space-6) 0;">

    <p class="text-center mb-0 text-secondary small">
      Đã có tài khoản?
      <a href="/users/login" class="fw-bold text-decoration-none text-primary">Đăng nhập</a>
    </p>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  // Show / Hide password
  function togglePassword() {
    const password = document.getElementById("password");
    const icon = document.getElementById("eyeIcon");
    if (password.type === "password") {
      password.type = "text";
      icon.classList.remove("bi-eye");
      icon.classList.add("bi-eye-slash");
    } else {
      password.type = "password";
      icon.classList.remove("bi-eye-slash");
      icon.classList.add("bi-eye");
    }
  }

  // Real-time Validation for Username
  const usernameInput = document.getElementById('username');
  const usernameFeedback = document.getElementById('usernameFeedback');

  usernameInput.addEventListener('input', () => {
    const val = usernameInput.value;
    const regex = /^[a-zA-Z0-9_]+$/;
    
    if (val.length < 3) {
      usernameInput.setCustomValidity('Too short');
      usernameFeedback.textContent = 'Tài khoản phải dài tối thiểu 3 ký tự.';
    } else if (!regex.test(val)) {
      usernameInput.setCustomValidity('Invalid characters');
      usernameFeedback.textContent = 'Tài khoản chỉ được dùng chữ cái, chữ số và dấu gạch dưới (_).';
    } else {
      usernameInput.setCustomValidity('');
    }
  });

  // Real-time Password Strength Check
  const passwordInput = document.getElementById('password');
  const reqLength = document.getElementById('reqLength');
  const reqAlphaNum = document.getElementById('reqAlphaNum');

  passwordInput.addEventListener('input', () => {
    const val = passwordInput.value;
    const hasLetter = /[a-zA-Z]/.test(val);
    const hasNumber = /[0-9]/.test(val);
    
    // Check length
    if (val.length >= 6) {
      reqLength.classList.remove('invalid');
      reqLength.classList.add('valid');
      reqLength.querySelector('i').className = 'bi bi-check-circle-fill';
    } else {
      reqLength.classList.remove('valid');
      reqLength.classList.add('invalid');
      reqLength.querySelector('i').className = 'bi bi-x-circle-fill';
    }

    // Check letter & number
    if (hasLetter && hasNumber) {
      reqAlphaNum.classList.remove('invalid');
      reqAlphaNum.classList.add('valid');
      reqAlphaNum.querySelector('i').className = 'bi bi-check-circle-fill';
    } else {
      reqAlphaNum.classList.remove('valid');
      reqAlphaNum.classList.add('invalid');
      reqAlphaNum.querySelector('i').className = 'bi bi-x-circle-fill';
    }

    // Set validity
    if (val.length >= 6 && hasLetter && hasNumber) {
      passwordInput.setCustomValidity('');
    } else {
      passwordInput.setCustomValidity('Weak password');
    }
  });

  // Role selection function
  function selectRole(role) {
    document.getElementById('selectedRole').value = role;
    
    // Toggle active classes on cards
    document.querySelectorAll('#roleCards .role-card').forEach(card => {
      if (card.getAttribute('data-role') === role) {
        card.classList.add('selected');
      } else {
        card.classList.remove('selected');
      }
    });

    // Hide error feedback
    document.getElementById('roleFeedback').classList.add('d-none');
    document.getElementById('selectedRole').setCustomValidity('');
  }

  // Client-side validation bootstrap
  (() => {
    'use strict'
    const forms = document.querySelectorAll('.needs-validation')
    Array.from(forms).forEach(form => {
      form.addEventListener('submit', event => {
        // Trigger manual validate checks
        usernameInput.dispatchEvent(new Event('input'));
        passwordInput.dispatchEvent(new Event('input'));

        // Check role select
        const selectedRole = document.getElementById('selectedRole').value;
        const roleFeedback = document.getElementById('roleFeedback');
        if (!selectedRole) {
          roleFeedback.classList.remove('d-none');
          document.getElementById('selectedRole').setCustomValidity('Please select a role');
          event.preventDefault();
          event.stopPropagation();
        } else {
          roleFeedback.classList.add('d-none');
          document.getElementById('selectedRole').setCustomValidity('');
        }

        if (!form.checkValidity()) {
          event.preventDefault()
          event.stopPropagation()
        }
        form.classList.add('was-validated')
      }, false)
    })
  })()
</script>
</body>
</html>