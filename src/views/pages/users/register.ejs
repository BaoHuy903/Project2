<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <!-- Google Fonts & Icons -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #f8fafc;
      color: #1e293b;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .register-container {
      width: 100%;
      max-width: 400px;
      padding: 20px;
    }
    .register-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 36px 30px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.02);
    }
    .logo-area {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-bottom: 28px;
    }
    .logo-icon {
      font-size: 2.2rem;
      color: #1e3a8a;
      margin-bottom: 8px;
    }
    .form-control-custom {
      background: #ffffff;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      color: #0f172a;
      padding: 10px 40px 10px 40px;
      font-size: 0.95rem;
      transition: all 0.15s ease-in-out;
    }
    .form-control-custom:focus {
      background: #ffffff;
      border-color: #2563eb;
      box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
      color: #0f172a;
    }
    .input-group-custom {
      position: relative;
      margin-bottom: 12px;
    }
    .input-group-custom .input-icon {
      position: absolute;
      left: 14px;
      top: 22px;
      transform: translateY(-50%);
      color: #64748b;
      font-size: 1rem;
      z-index: 10;
      transition: color 0.15s;
    }
    .input-group-custom:focus-within .input-icon {
      color: #2563eb;
    }
    .input-group-custom .eye-toggle {
      position: absolute;
      right: 14px;
      top: 22px;
      transform: translateY(-50%);
      color: #64748b;
      cursor: pointer;
      z-index: 10;
      font-size: 1rem;
    }
    .input-group-custom .eye-toggle:hover {
      color: #2563eb;
    }
    .btn-submit {
      background-color: #1e3a8a;
      border: 1px solid #1e3a8a;
      border-radius: 8px;
      padding: 12px;
      font-weight: 600;
      font-size: 0.95rem;
      color: white;
      transition: all 0.15s ease-in-out;
    }
    .btn-submit:hover {
      background-color: #1e40af;
      border-color: #1e40af;
    }
    .btn-submit:active {
      transform: translateY(1px);
    }
    .form-label {
      font-size: 0.88rem;
      color: #475569;
      margin-bottom: 6px;
      font-weight: 500;
    }
    .alert-custom {
      background: #fef2f2;
      border: 1px solid #fee2e2;
      color: #991b1b;
      border-radius: 8px;
      padding: 10px 14px;
      font-size: 0.88rem;
    }
    /* Password requirements list */
    .req-list {
      font-size: 0.8rem;
      color: #64748b;
      list-style-type: none;
      padding-left: 0;
      margin-top: 5px;
      margin-bottom: 20px;
    }
    .req-list li {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 4px;
    }
    .req-list li.valid {
      color: #16a34a;
    }
    .req-list li.invalid {
      color: #dc2626;
    }
    /* Disable Bootstrap validation checkmarks and green borders */
    .was-validated .form-control:valid, 
    .was-validated .form-control-custom:valid {
      border-color: #cbd5e1 !important;
      background-image: none !important;
      padding-right: 14px !important;
    }
    .was-validated .form-control:valid:focus,
    .was-validated .form-control-custom:valid:focus {
      border-color: #2563eb !important;
      box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1) !important;
    }
    .was-validated .form-control:invalid, 
    .was-validated .form-control-custom:invalid {
      background-image: none !important;
      border-color: #ef4444 !important;
    }
    
    /* Role selection cards */
    .role-card {
      background: #ffffff;
      border: 1px solid #cbd5e1 !important;
      transition: all 0.15s ease-in-out;
      cursor: pointer;
      user-select: none;
      position: relative;
    }
    .role-card:hover {
      border-color: #94a3b8 !important;
      background-color: #f8fafc;
    }
    .role-card.selected {
      border-color: #2563eb !important;
      background-color: rgba(37, 99, 235, 0.04) !important;
      box-shadow: 0 0 0 1px #2563eb;
    }
    .role-card.selected i {
      color: #2563eb !important;
    }
    .cursor-pointer {
      cursor: pointer;
    }
    /* Hide default browser eye icon for password input */
    input[type="password"]::-ms-reveal,
    input[type="password"]::-ms-clear {
      display: none;
    }
  </style>
</head>
<body>

<div class="register-container">
  <div class="register-card">
    <div class="logo-area">
      <i class="bi bi-person-plus logo-icon"></i>
      <h4 class="fw-bold mb-1 text-dark">ĐĂNG KÝ</h4>
      <p class="text-secondary small mb-0">Tạo tài khoản mới của bạn</p>
    </div>

    <!-- Error Alert -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-custom alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-exclamation-circle-fill me-2"></i> <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" style="font-size:0.75rem; padding: 1.15rem;"></button>
      </div>
    <% } %>

    <form id="registerForm" method="POST" action="/users/register" class="needs-validation" novalidate>
      <!-- Username -->
      <div class="mb-3">
        <label class="form-label">Tài khoản</label>
        <div class="input-group-custom">
          <i class="bi bi-person input-icon"></i>
          <input type="text" id="username" name="username" class="form-control form-control-custom w-100" placeholder="Chỉ chứa chữ và số, không khoảng trắng" required minlength="3" autocomplete="username">
          <div class="invalid-feedback text-danger small mt-1" id="usernameFeedback">Tài khoản phải dài tối thiểu 3 ký tự.</div>
        </div>
      </div>

      <!-- Password -->
      <div class="mb-2">
        <label class="form-label">Mật khẩu</label>
        <div class="input-group-custom">
          <i class="bi bi-lock input-icon"></i>
          <input type="password" id="password" name="password" class="form-control form-control-custom w-100" placeholder="Nhập mật khẩu..." required autocomplete="new-password">
          <i id="eyeIcon" class="bi bi-eye eye-toggle" onclick="togglePassword()"></i>
          <div class="invalid-feedback text-danger small mt-1">Mật khẩu không hợp lệ.</div>
        </div>
      </div>

      <!-- Password Requirements -->
      <ul class="req-list" id="passwordReqs">
        <li id="reqLength" class="invalid"><i class="bi bi-x-circle-fill"></i> Tối thiểu 6 ký tự</li>
        <li id="reqAlphaNum" class="invalid"><i class="bi bi-x-circle-fill"></i> Chứa cả chữ cái và chữ số</li>
      </ul>

      <!-- Role Selection -->
      <div class="mb-4">
        <label class="form-label d-block text-start mb-2">Vai trò của bạn</label>
        <div class="row g-3" id="roleCards">
          <div class="col-6">
            <div class="role-card border rounded p-3 text-center cursor-pointer h-100" data-role="TENANT" onclick="selectRole('TENANT')">
              <i class="bi bi-house-heart fs-3 mb-2 d-block text-secondary" id="icon-tenant"></i>
              <span class="fw-semibold d-block text-dark" style="font-size: 0.9rem;">Khách thuê</span>
              <small class="text-muted d-block" style="font-size: 0.72rem; line-height: 1.2;">Tìm kiếm và xem phòng trọ</small>
            </div>
          </div>
          <div class="col-6">
            <div class="role-card border rounded p-3 text-center cursor-pointer h-100" data-role="LANDLORD" onclick="selectRole('LANDLORD')">
              <i class="bi bi-building-up fs-3 mb-2 d-block text-secondary" id="icon-landlord"></i>
              <span class="fw-semibold d-block text-dark" style="font-size: 0.9rem;">Chủ trọ</span>
              <small class="text-muted d-block" style="font-size: 0.72rem; line-height: 1.2;">Đăng tin cho thuê phòng</small>
            </div>
          </div>
        </div>
        <input type="hidden" id="selectedRole" name="role" required>
        <div class="text-danger small mt-2 d-none" id="roleFeedback" style="font-size: 0.8rem;">
          <i class="bi bi-exclamation-circle-fill me-1"></i> Vui lòng chọn vai trò của bạn trước khi đăng ký.
        </div>
      </div>

      <!-- Button -->
      <div class="d-grid mb-3">
        <button type="submit" class="btn btn-submit" id="btnSubmit">
          Đăng ký <i class="bi bi-check-circle ms-1 align-middle"></i>
        </button>
      </div>
    </form>

    <hr style="border-color: #e2e8f0; margin: 20px 0;">

    <p class="text-center mb-0 text-secondary small">
      Đã có tài khoản?
      <a href="/users/login" class="fw-bold text-decoration-none" style="color: #2563eb">Đăng nhập</a>
    </p>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  // Show / Hide password
  function togglePassword() {
    const password = document.getElementById("password");
    const icon = document.getElementById("eyeIcon");
    if (password.type === "password") {
      password.type = "text";
      icon.classList.remove("bi-eye");
      icon.classList.add("bi-eye-slash");
    } else {
      password.type = "password";
      icon.classList.remove("bi-eye-slash");
      icon.classList.add("bi-eye");
    }
  }

  // Real-time Validation for Username
  const usernameInput = document.getElementById('username');
  const usernameFeedback = document.getElementById('usernameFeedback');

  usernameInput.addEventListener('input', () => {
    const val = usernameInput.value;
    const regex = /^[a-zA-Z0-9_]+$/;
    
    if (val.length < 3) {
      usernameInput.setCustomValidity('Too short');
      usernameFeedback.textContent = 'Tài khoản phải dài tối thiểu 3 ký tự.';
    } else if (!regex.test(val)) {
      usernameInput.setCustomValidity('Invalid characters');
      usernameFeedback.textContent = 'Tài khoản chỉ được dùng chữ cái, chữ số và dấu gạch dưới (_).';
    } else {
      usernameInput.setCustomValidity('');
    }
  });

  // Real-time Password Strength Check
  const passwordInput = document.getElementById('password');
  const reqLength = document.getElementById('reqLength');
  const reqAlphaNum = document.getElementById('reqAlphaNum');

  passwordInput.addEventListener('input', () => {
    const val = passwordInput.value;
    const hasLetter = /[a-zA-Z]/.test(val);
    const hasNumber = /[0-9]/.test(val);
    
    // Check length
    if (val.length >= 6) {
      reqLength.classList.remove('invalid');
      reqLength.classList.add('valid');
      reqLength.querySelector('i').className = 'bi bi-check-circle-fill';
    } else {
      reqLength.classList.remove('valid');
      reqLength.classList.add('invalid');
      reqLength.querySelector('i').className = 'bi bi-x-circle-fill';
    }

    // Check letter & number
    if (hasLetter && hasNumber) {
      reqAlphaNum.classList.remove('invalid');
      reqAlphaNum.classList.add('valid');
      reqAlphaNum.querySelector('i').className = 'bi bi-check-circle-fill';
    } else {
      reqAlphaNum.classList.remove('valid');
      reqAlphaNum.classList.add('invalid');
      reqAlphaNum.querySelector('i').className = 'bi bi-x-circle-fill';
    }

    // Set validity
    if (val.length >= 6 && hasLetter && hasNumber) {
      passwordInput.setCustomValidity('');
    } else {
      passwordInput.setCustomValidity('Weak password');
    }
  });

  // Role selection function
  function selectRole(role) {
    document.getElementById('selectedRole').value = role;
    
    // Toggle active classes on cards
    document.querySelectorAll('#roleCards .role-card').forEach(card => {
      if (card.getAttribute('data-role') === role) {
        card.classList.add('selected');
      } else {
        card.classList.remove('selected');
      }
    });

    // Hide error feedback
    document.getElementById('roleFeedback').classList.add('d-none');
    document.getElementById('selectedRole').setCustomValidity('');
  }

  // Client-side validation bootstrap
  (() => {
    'use strict'
    const forms = document.querySelectorAll('.needs-validation')
    Array.from(forms).forEach(form => {
      form.addEventListener('submit', event => {
        // Trigger manual validate checks
        usernameInput.dispatchEvent(new Event('input'));
        passwordInput.dispatchEvent(new Event('input'));

        // Check role select
        const selectedRole = document.getElementById('selectedRole').value;
        const roleFeedback = document.getElementById('roleFeedback');
        if (!selectedRole) {
          roleFeedback.classList.remove('d-none');
          document.getElementById('selectedRole').setCustomValidity('Please select a role');
          event.preventDefault();
          event.stopPropagation();
        } else {
          roleFeedback.classList.add('d-none');
          document.getElementById('selectedRole').setCustomValidity('');
        }

        if (!form.checkValidity()) {
          event.preventDefault()
          event.stopPropagation()
        }
        form.classList.add('was-validated')
      }, false)
    })
  })()
</script>
</body>
</html>