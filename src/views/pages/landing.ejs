          <div class="footer-socials">
            <a href="#"><i class="bi bi-facebook"></i></a>
            <a href="#"><i class="bi bi-chat-text-fill"></i></a>
            <a href="#"><i class="bi bi-youtube"></i></a>
          </div>
        </div>
        <div class="col-lg-2 col-md-6">
          <h6 class="footer-heading">Khu vực</h6>
          <ul class="footer-links">
            <li><a href="/rooms?district=Hải+Châu">Hải Châu</a></li>
            <li><a href="/rooms?district=Thanh+Khê">Thanh Khê</a></li>
            <li><a href="/rooms?district=Sơn+Trà">Sơn Trà</a></li>
            <li><a href="/rooms?district=Liên+Chiểu">Liên Chiểu</a></li>
          </ul>
        </div>
        <div class="col-lg-2 col-md-6">
          <h6 class="footer-heading">Liên kết</h6>
          <ul class="footer-links">
            <li><a href="/rooms">Tìm phòng</a></li>
            <li><a href="/users/register">Đăng ký</a></li>
            <li><a href="/users/login">Đăng nhập</a></li>
          </ul>
