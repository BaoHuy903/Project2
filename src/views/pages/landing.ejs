<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <meta name="description" content="TrọVíp - Nền tảng tìm kiếm và đăng tin phòng trọ hàng đầu Đà Nẵng. Kết nối trực tiếp chủ trọ và người thuê. Miễn phí, nhanh chóng, uy tín.">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/design-system.css">
  <link rel="stylesheet" href="/css/landing.css">
</head>
<body>

  <!-- Navbar -->
  <nav class="landing-nav">
    <div class="container d-flex align-items-center justify-content-between">
      <a href="/" class="nav-logo">
        <i class="bi bi-house-door"></i> TrọVíp
      </a>
      <div class="d-flex align-items-center gap-3">
        <a href="/rooms" class="btn-tv btn-tv-ghost btn-tv-sm d-none d-sm-inline-flex">
          <i class="bi bi-search"></i> Tìm phòng
        </a>
        <% if (user) { %>
          <% if (user.role === ROLES.LANDLORD || user.role === ROLES.ADMIN) { %>
            <a href="/rooms/add" class="btn-tv btn-tv-accent btn-tv-sm">
              <i class="bi bi-plus-lg"></i> <span class="d-none d-sm-inline">Đăng tin</span>
            </a>
          <% } %>
          <div class="dropdown">
            <button class="tv-avatar-btn btn btn-link text-decoration-none p-0 border-0" data-bs-toggle="dropdown" style="font-size: 1.5rem; color: var(--color-primary); line-height: 1; display: block;">
              <i class="bi bi-person-circle"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" style="border-radius: var(--radius-md); min-width: 200px;">
              <li class="dropdown-header py-2.5 px-3">
                <strong class="d-block text-dark"><%= user.username %></strong>
                <small class="text-muted"><%= user.role %></small>
              </li>
              <li><hr class="dropdown-divider my-1"></li>
              <% if (user.role === ROLES.ADMIN) { %>
                <li><a class="dropdown-item py-2" href="/admin"><i class="bi bi-speedometer2 me-2"></i>Admin Dashboard</a></li>
              <% } else if (user.role === ROLES.LANDLORD) { %>
                <li><a class="dropdown-item py-2" href="/rooms/dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
              <% } %>
              <li><a class="dropdown-item py-2" href="/users/change-password"><i class="bi bi-key me-2"></i>Đổi mật khẩu</a></li>
              <li><hr class="dropdown-divider my-1"></li>
              <li><a class="dropdown-item py-2 text-danger" href="/users/logout"><i class="bi bi-box-arrow-left me-2"></i>Đăng xuất</a></li>
            </ul>
          </div>
        <% } else { %>
          <a href="/users/login" class="btn-tv btn-tv-outline btn-tv-sm">Đăng nhập</a>
          <a href="/users/register" class="btn-tv btn-tv-primary btn-tv-sm">Đăng ký</a>
        <% } %>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="hero-section">
    <!-- Image Background -->
    <img src="/images/banner.png" alt="Đà Nẵng Cityscape" class="hero-image-bg">
    <div class="hero-bg"></div>
    <div class="container position-relative" style="z-index: 2;">
      <div class="hero-content text-center">
        <div class="hero-badge animate-fade-in-up">
          <i class="bi bi-geo-alt-fill"></i> Đà Nẵng
        </div>
        <h1 class="hero-title animate-fade-in-up">
          Tìm phòng trọ<br>
          <span class="hero-highlight">chưa bao giờ dễ hơn</span>
        </h1>
        <p class="hero-subtitle animate-fade-in-up">
          Hệ thống kết nối trực tiếp chủ trọ và người thuê. Thông tin cập nhật liên tục, miễn phí 100%.
        </p>

        <!-- Search Bar -->
        <div class="hero-search animate-fade-in-up">
          <form class="search-form" action="/rooms" method="GET">
            <div class="search-input-wrapper">
              <i class="bi bi-search search-icon"></i>
              <input type="text" name="q" class="search-input" placeholder="Tìm theo quận, phường, đường...">
            </div>
            <button type="submit" class="btn-tv btn-tv-accent btn-tv-lg search-btn">
              <i class="bi bi-search d-sm-none"></i>
              <span class="d-none d-sm-inline">Tìm phòng ngay</span>
            </button>
          </form>
        </div>

        <!-- Quick Filters -->
        <div class="quick-filters animate-fade-in-up">
          <a href="/rooms?district=Hải+Châu" class="quick-filter-chip">
            <i class="bi bi-buildings"></i> Hải Châu
          </a>
          <a href="/rooms?district=Thanh+Khê" class="quick-filter-chip">
            <i class="bi bi-buildings"></i> Thanh Khê
          </a>
          <a href="/rooms?district=Sơn+Trà" class="quick-filter-chip">
            <i class="bi bi-buildings"></i> Sơn Trà
          </a>
          <a href="/rooms?district=Liên+Chiểu" class="quick-filter-chip">
            <i class="bi bi-buildings"></i> Liên Chiểu
          </a>
          <a href="/rooms?district=Ngũ+Hành+Sơn" class="quick-filter-chip d-none d-md-inline-flex">
            <i class="bi bi-buildings"></i> Ngũ Hành Sơn
          </a>
          <a href="/rooms?district=Cẩm+Lệ" class="quick-filter-chip d-none d-md-inline-flex">
            <i class="bi bi-buildings"></i> Cẩm Lệ
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="stats-section">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-item animate-fade-in-up">
          <div class="stat-number">10+</div>
          <div class="stat-label">Tin đăng</div>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item animate-fade-in-up">
          <div class="stat-number">100%</div>
          <div class="stat-label">Miễn phí</div>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item animate-fade-in-up">
          <div class="stat-number">24/7</div>
          <div class="stat-label">Hỗ trợ</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Rooms -->
  <% if (typeof rooms !== 'undefined' && rooms.length > 0) { %>
  <section class="featured-section">
    <div class="container">
      <div class="section-header">
        <div>
          <h2 class="section-title">Phòng trọ mới nhất</h2>
          <p class="section-subtitle">Tin đăng mới nhất được cập nhật liên tục</p>
        </div>
        <a href="/rooms" class="btn-tv btn-tv-outline">
          Xem tất cả <i class="bi bi-arrow-right ms-1"></i>
        </a>
      </div>

      <div class="rooms-grid">
        <% rooms.forEach((room, idx) => { %>
        <div class="room-card-landing room-card animate-fade-in-up"
             data-id="<%= room.id %>"
             data-room="<%= encodeURIComponent(JSON.stringify(room)) %>"
             style="animation-delay: <%= idx * 0.08 %>s"
             onclick="handleCardClick(event, this)">
          <div class="room-card-img<%= room.isAvailable === false ? ' img-rented' : '' %>">
            <img src="<%= room.images && room.images.length > 0 ? room.images[0] : 'https://images.unsplash.com/photo-1522771739844-6a9f6d5f14af?auto=format&fit=crop&w=400&h=280&q=80' %>" alt="<%= room.title %>" loading="lazy">
            <% if (room.isAvailable !== false) { %>
              <span class="room-status-badge available">Còn trống</span>
            <% } else { %>
              <span class="room-status-badge rented">Đã thuê</span>
            <% } %>
            <div class="room-price-badge">
              <%= room.price ? (room.price / 1000000).toLocaleString('vi-VN') : 0 %> tr/th
            </div>
          </div>
          <div class="room-card-body">
            <h3 class="room-card-title truncate-2"><%= room.title %></h3>
            <div class="room-card-location">
              <i class="bi bi-geo-alt"></i>
              <span class="truncate-2"><%= room.address %></span>
            </div>
            <div class="room-card-meta">
              <span><i class="bi bi-rulers"></i> <%= room.area || 0 %> m²</span>
              <span><i class="bi bi-grid"></i> <%= room.category || 'Cơ bản' %></span>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- How It Works -->
  <section class="how-section">
    <div class="container">
      <div class="text-center mb-5">
        <h2 class="section-title">Cách hoạt động</h2>
        <p class="section-subtitle">Tìm phòng trọ hoặc đăng tin chỉ trong vài bước đơn giản</p>
      </div>
      <div class="how-grid">
        <div class="how-card animate-fade-in-up">
          <div class="how-icon how-icon-blue">
            <i class="bi bi-search"></i>
          </div>
          <h4>Tìm kiếm</h4>
          <p>Lọc phòng theo khu vực, giá, diện tích và tiện ích phù hợp nhu cầu.</p>
        </div>
        <div class="how-card animate-fade-in-up" style="animation-delay: 0.1s">
          <div class="how-icon how-icon-green">
            <i class="bi bi-telephone"></i>
          </div>
          <h4>Liên hệ</h4>
          <p>Gọi điện hoặc nhắn tin trực tiếp cho chủ trọ, không qua trung gian.</p>
        </div>
        <div class="how-card animate-fade-in-up" style="animation-delay: 0.2s">
          <div class="how-icon how-icon-orange">
            <i class="bi bi-key"></i>
          </div>
          <h4>Dọn vào ở</h4>
          <p>Thỏa thuận, ký hợp đồng và chuyển đến ngôi nhà mới của bạn.</p>
        </div>
      </div>
    </div>
  </section>


  <!-- CTA Section -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-card">
        <div class="cta-content">
          <h2>Bạn là chủ trọ?</h2>
          <p>Đăng tin miễn phí, tiếp cận hàng nghìn người tìm phòng. Quản lý bài đăng dễ dàng với dashboard chuyên nghiệp.</p>
          <div class="d-flex flex-wrap gap-3">
            <a href="/users/register" class="btn-tv btn-tv-accent btn-tv-lg">
              <i class="bi bi-pencil-square"></i> Đăng tin ngay
            </a>
            <a href="/rooms" class="btn-tv btn-tv-outline-white btn-tv-lg">
              <i class="bi bi-arrow-right"></i> Tìm phòng
            </a>
          </div>
        </div>
        <div class="cta-visual">
          <div class="cta-float-card">
            <i class="bi bi-house-check-fill"></i>
            <div>
              <strong>Đăng tin dễ dàng</strong>
              <span>Chỉ 3 phút để hoàn thành</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== ROOM DETAIL MODAL (LANDING) ========== -->
  <div class="modal fade" id="roomDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content tv-modal-content position-relative animate-fade-in">
        <!-- Close Button -->
        <button type="button" class="btn-close tv-modal-close-btn" data-bs-dismiss="modal" aria-label="Close"></button>

        <!-- Carousel -->
        <div class="tv-modal-carousel carousel slide" id="detailCarousel">
          <div id="carouselInner" class="carousel-inner"></div>
          <button class="carousel-control-prev" type="button" data-bs-target="#detailCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
          </button>
          <button class="carousel-control-next" type="button" data-bs-target="#detailCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
          </button>
        </div>
        <div class="carousel-thumbnails" id="carouselThumbnails" style="display: none;"></div>

        <div class="modal-body tv-modal-body">
          <!-- Status & Save -->
          <div class="d-flex align-items-center justify-content-between mb-3">
            <span id="detailBadgeStatus" class="badge-tv badge-tv-success">Còn trống</span>
            <button class="btn-tv btn-tv-ghost btn-tv-sm btn-fav-toggle" id="detailFavBtn" style="display: none !important;">
              <i class="bi bi-heart text-secondary"></i> Lưu tin
            </button>
          </div>

          <!-- Price -->
          <div class="tv-detail-price" id="detailPrice">0 triệu/tháng</div>
          <span class="badge-tv badge-tv-neutral mb-3" id="detailDepositBadge" style="display:none">
            <i class="bi bi-shield-check"></i> Cọc: <span id="detailDeposit">0</span>đ
          </span>

          <!-- Title -->
          <h2 class="tv-detail-title" id="detailTitle">Tiêu đề</h2>

          <!-- Location -->
          <div class="tv-detail-location mb-4">
            <i class="bi bi-geo-alt-fill text-danger"></i>
            <span id="detailAddress">Địa chỉ</span>
          </div>

          <!-- Info Grid -->
          <div class="tv-detail-info-grid mb-4">
            <div class="tv-info-item">
              <i class="bi bi-rulers"></i>
              <div>
                <span class="tv-info-label">Diện tích</span>
                <span class="tv-info-value"><span id="detailArea">0</span> m²</span>
              </div>
            </div>
            <div class="tv-info-item">
              <i class="bi bi-grid"></i>
              <div>
                <span class="tv-info-label">Nội thất</span>
                <span class="tv-info-value" id="detailCategory">Cơ bản</span>
              </div>
            </div>
            <div class="tv-info-item">
              <i class="bi bi-door-open"></i>
              <div>
                <span class="tv-info-label">Loại phòng</span>
                <span class="tv-info-value" id="detailStatus">Ở đơn</span>
              </div>
            </div>
            <div class="tv-info-item">
              <i class="bi bi-calendar3"></i>
              <div>
                <span class="tv-info-label">Cọc trước</span>
                <span class="tv-info-value" id="detailDepositMonth">Chưa cập nhật</span>
              </div>
            </div>
            <div class="tv-info-item">
              <i class="bi bi-repeat"></i>
              <div>
                <span class="tv-info-label">Chu kỳ trả</span>
                <span class="tv-info-value" id="detailPaymentCycle">Chưa cập nhật</span>
              </div>
            </div>
            <div class="tv-info-item">
              <i class="bi bi-calendar-check"></i>
              <div>
                <span class="tv-info-label">Có thể vào ở từ</span>
                <span class="tv-info-value" id="detailAvailableFrom">Chưa cập nhật</span>
              </div>
            </div>

          </div>

          <!-- Utility Costs -->
          <div class="tv-detail-costs mb-4">
            <div class="tv-cost-item">
              <i class="bi bi-lightning-charge text-warning"></i>
              <span>Điện: <strong id="detailElectricity">Chưa cập nhật</strong></span>
            </div>
            <div class="tv-cost-item">
              <i class="bi bi-droplet text-primary"></i>
              <span>Nước: <strong id="detailWater">Chưa cập nhật</strong></span>
            </div>
          </div>

          <!-- Amenities -->
          <div class="tv-detail-amenities mb-4" id="detailAmenities" style="display:none">
            <h6 class="tv-detail-section-title">Tiện ích</h6>
            <div class="tv-amenities-grid" id="detailAmenitiesList"></div>
          </div>

          <!-- Description -->
          <div class="tv-detail-description mb-4">
            <h6 class="tv-detail-section-title">Mô tả</h6>
            <p id="detailDescription">Mô tả phòng trọ</p>
          </div>

          <!-- Host Info -->
          <div class="tv-detail-host">
            <div class="tv-host-info">
              <div class="tv-host-avatar">
                <i class="bi bi-person-circle"></i>
              </div>
              <div>
                <strong id="detailHostName">Chủ trọ</strong>
                <span id="detailHostRole">Cá nhân</span>
              </div>
            </div>
            <div class="d-flex flex-column flex-sm-row gap-2">
              <a href="tel:" class="btn-tv btn-tv-success btn-tv-sm" id="btnCallHost">
                <i class="bi bi-telephone"></i> <span id="detailPhone">SĐT</span>
              </a>
              <a href="#" target="_blank" class="btn-tv btn-tv-primary btn-tv-sm" id="btnZaloHost">
                <i class="bi bi-chat-dots"></i> Nhắn Zalo
              </a>
