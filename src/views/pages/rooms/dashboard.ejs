<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/design-system.css">
  <link rel="stylesheet" href="/css/admin/dashboard.css">
</head>
<body>

<div class="container-fluid p-0">
  <div class="dashboard-container">
    <!-- Sidebar -->
    <%- include('../../components/sidebarLandlord', { activeTab: 'dashboard' }) %>

    <!-- Main Content -->
    <div class="db-main">
      <!-- Header -->
      <div class="db-header">
        <div>
          <h1 class="db-title">Bảng điều khiển Chủ trọ</h1>
          <p class="db-subtitle">Quản lý các tin đăng phòng trọ của bạn</p>
        </div>
        <div class="d-flex align-items-center gap-3">
          <a href="/rooms/add" class="btn-tv btn-tv-accent btn-tv-sm rounded-pill d-none d-md-inline-flex">
            <i class="bi bi-plus-lg"></i> Đăng phòng mới
          </a>
        </div>
      </div>

      <!-- Stats Cards -->
      <%
        let totalRooms = rooms.length;
        let availableRooms = rooms.filter(r => r.isAvailable !== false).length;
        let rentedRooms = totalRooms - availableRooms;
      %>
      <div class="db-stats-grid">
        <div class="db-stat-card">
          <div>
            <div class="db-stat-label">Tổng phòng đăng</div>
            <div class="db-stat-value"><%= totalRooms %></div>
            <div class="db-stat-trend text-primary">Phòng đã duyệt</div>
          </div>
          <div class="db-stat-icon blue">
            <i class="bi bi-house-door-fill"></i>
          </div>
        </div>

        <div class="db-stat-card">
          <div>
            <div class="db-stat-label">Đang trống</div>
            <div class="db-stat-value"><%= availableRooms %></div>
            <div class="db-stat-trend">Sẵn sàng cho thuê</div>
          </div>
          <div class="db-stat-icon green">
            <i class="bi bi-door-open-fill"></i>
          </div>
        </div>

        <div class="db-stat-card">
          <div>
            <div class="db-stat-label">Đã cho thuê</div>
            <div class="db-stat-value"><%= rentedRooms %></div>
            <div class="db-stat-trend text-danger">Đã có người ở</div>
          </div>
          <div class="db-stat-icon red">
            <i class="bi bi-door-closed-fill"></i>
          </div>
        </div>

      </div>

      <!-- Main Room Management Section -->
      <div class="db-card">
        <div class="db-card-header flex-wrap gap-2">
          <h5 class="db-card-title">Danh sách tin đăng phòng trọ của bạn</h5>
          <div class="d-flex align-items-center gap-2">
            <span class="text-secondary small fw-medium text-nowrap">Trạng thái:</span>
            <select class="form-select form-select-sm border" id="statusFilter" style="width: 130px; font-size: 0.85rem;" onchange="filterDashboardRooms()">
              <option value="all">Tất cả</option>
              <option value="available">Còn trống</option>
              <option value="rented">Đã thuê</option>
            </select>
          </div>
        </div>

        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0 table-tv">
            <thead>
              <tr>
                <th class="ps-3" style="width: 100px;">Hình ảnh</th>
                <th>Tiêu đề / Địa chỉ</th>
                <th>Giá / Diện tích</th>
                <th class="text-center text-nowrap">Trạng thái</th>
                <th class="text-center">Hành động</th>
              </tr>
            </thead>
            <tbody>
              <% if(rooms && rooms.length > 0) { %>
                <% rooms.forEach(room => { %>
                  <tr id="room-row-<%= room.id %>" data-status="<%= room.isAvailable !== false ? 'available' : 'rented' %>">
                    <td class="ps-3">
                      <img src="<%= room.images && room.images.length > 0 ? room.images[0] : 'https://images.unsplash.com/photo-1522771739844-6a9f6d5f14af?auto=format&fit=crop&w=120&h=80&q=80' %>" 
                           alt="Room thumbnail" 
                           class="rounded" 
                           style="width: 80px; height: 55px; object-fit: cover;">
                    </td>
                    <td>
                      <div class="fw-bold text-dark text-truncate" style="max-width: 320px;"><%= room.title %></div>
                      <div class="text-secondary small mt-1"><i class="bi bi-geo-alt text-danger me-1"></i><%= room.address %></div>
                    </td>
                    <td>
                      <div class="fw-bold text-danger"><%= room.price ? (room.price / 1000000).toLocaleString('vi-VN') : 0 %> triệu/tháng</div>
                      <div class="text-muted small">Diện tích: <%= room.area || 0 %> m²</div>
                    </td>
                    <td class="text-center">
                      <% const isAvail = room.isAvailable !== false; %>
                      <span class="<%= isAvail ? 'badge-status-empty' : 'badge-status-rented' %>" 
                            id="room-badge-<%= room.id %>">
                        <%= isAvail ? 'Còn trống' : 'Đã thuê' %>
                      </span>
                    </td>
                    <td class="text-center text-nowrap">
                      <a href="/rooms/edit/<%= room.id %>" class="btn btn-sm btn-outline-primary me-2 rounded"
                         title="Chỉnh sửa tin đăng"
                         style="width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center; background: #fff;">
                        <i class="bi bi-pencil-square"></i>
                      </a>
                      <button class="btn btn-sm btn-outline-secondary me-2 rounded btn-action-toggle" 
                              onclick="toggleRoomStatus('<%= room.id %>')"
                              title="Đổi trạng thái phòng"
                              style="width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center; background: #fff;">
                        <i class="bi bi-arrow-repeat"></i>
                      </button>
                      <button class="btn btn-sm btn-outline-danger rounded" 
                              onclick="deleteRoom('<%= room.id %>')"
                              title="Xóa tin đăng"
                              style="width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center; background: #fff;">
                        <i class="bi bi-trash"></i>
                      </button>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="text-center py-5 text-muted">
                    <i class="bi bi-house-exclamation d-block fs-1 mb-2"></i>
                    Chưa có phòng trọ nào được đăng. Hãy tạo tin đăng đầu tiên ngay bây giờ!
                    <div class="mt-3">
                      <a href="/rooms/add" class="btn-tv btn-tv-primary btn-tv-sm">Đăng phòng ngay</a>
                    </div>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Confirm Delete Modal -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-hidden="true" style="z-index: 1060;">
  <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
    <div class="modal-content border-0 shadow-lg rounded-3">
      <div class="modal-body p-4 text-center">
        <div class="text-danger mb-3" style="font-size: 3rem;">
          <i class="bi bi-exclamation-triangle-fill"></i>
        </div>
        <h5 class="fw-bold text-dark mb-2" id="confirmDeleteTitle">Xác nhận xóa</h5>
        <p class="text-secondary small mb-4" id="confirmDeleteMessage">Bạn có chắc chắn muốn thực hiện hành động này không? Hành động này không thể hoàn tác.</p>
        <div class="d-flex justify-content-center gap-2">
          <button type="button" class="btn-tv btn-tv-outline btn-tv-sm" data-bs-dismiss="modal">Hủy</button>
          <button type="button" class="btn-tv btn-tv-danger btn-tv-sm" id="confirmDeleteBtn">Xác nhận xóa</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Alerts Toasts -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1060;">
  <div id="toastMessage" class="toast align-items-center text-bg-success border-0 rounded-3 toast-tv" role="alert" aria-live="assertive" aria-atomic="true">
    <div class="d-flex">
      <div class="toast-body" id="toastBody">
        Thao tác thành công!
      </div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/shared/toast.js"></script>
<script src="/js/rooms/dashboard.js"></script>
</body>
</html>
