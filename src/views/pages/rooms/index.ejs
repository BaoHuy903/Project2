<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <meta name="description" content="Tìm kiếm phòng trọ tại Đà Nẵng - TrọVíp. Lọc theo quận, giá, diện tích, tiện ích. Cập nhật liên tục.">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/design-system.css">
  <link rel="stylesheet" href="/css/rooms/index.css">
</head>
<body>

  <!-- ========== NAVBAR ========== -->
  <nav class="tv-navbar">
    <div class="container d-flex align-items-center justify-content-between">
      <a href="/" class="tv-navbar-brand">
        <i class="bi bi-house-door"></i> TrọVíp
      </a>

      <!-- Desktop Search -->
      <div class="tv-nav-search d-none d-lg-flex">
        <i class="bi bi-search"></i>
        <input type="text" id="searchInput" placeholder="Tìm theo tiêu đề, địa chỉ...">
      </div>

      <div class="tv-nav-actions">
        <% if (user) { %>
          <button class="btn-tv btn-tv-ghost btn-tv-sm" id="favNavBtn" onclick="toggleFavoritesOnly()" title="Tin đã lưu">
            <i class="bi bi-heart"></i> <span class="d-none d-md-inline">Đã lưu</span>
          </button>
          <% if (user.role === ROLES.LANDLORD || user.role === ROLES.ADMIN) { %>
            <a href="/rooms/add" class="btn-tv btn-tv-accent btn-tv-sm">
              <i class="bi bi-plus-lg"></i> <span class="d-none d-sm-inline">Đăng tin</span>
            </a>
          <% } %>
          <div class="dropdown">
            <button class="tv-avatar-btn" data-bs-toggle="dropdown">
              <i class="bi bi-person-circle"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end tv-dropdown">
              <li class="dropdown-header">
                <strong><%= user.username %></strong>
                <small class="text-muted"><%= user.role %></small>
              </li>
              <li><hr class="dropdown-divider"></li>
              <% if (user.role === ROLES.ADMIN) { %>
                <li><a class="dropdown-item" href="/admin"><i class="bi bi-speedometer2 me-2"></i>Admin Dashboard</a></li>
              <% } else if (user.role === ROLES.LANDLORD) { %>
                <li><a class="dropdown-item" href="/rooms/dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
              <% } %>
              <li><a class="dropdown-item" href="/users/change-password"><i class="bi bi-key me-2"></i>Đổi mật khẩu</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item text-danger" href="/users/logout"><i class="bi bi-box-arrow-left me-2"></i>Đăng xuất</a></li>
            </ul>
          </div>
        <% } else { %>
          <a href="/users/login" class="btn-tv btn-tv-outline btn-tv-sm">Đăng nhập</a>
          <a href="/users/register" class="btn-tv btn-tv-primary btn-tv-sm">Đăng ký</a>
        <% } %>
      </div>
    </div>
  </nav>

  <!-- Mobile Search -->
  <div class="tv-mobile-search d-lg-none">
    <div class="container">
      <div class="tv-search-bar-mobile">
        <i class="bi bi-search"></i>
        <input type="text" id="mobileSearchInput" placeholder="Tìm theo tiêu đề, địa chỉ...">
      </div>
    </div>
  </div>

  <!-- ========== FILTER BAR ========== -->
  <div class="tv-filter-bar">
    <div class="container">
      <div class="tv-filters-scroll">
        <!-- Reset -->
        <button class="filter-pill active" id="filterResetBtn" onclick="resetAllFilters()">
          <i class="bi bi-grid-3x3-gap"></i> Tất cả
        </button>

        <!-- Location -->
        <div class="dropdown">
          <button class="filter-pill" data-bs-toggle="dropdown" id="btnFilterLocation">
            <i class="bi bi-geo-alt"></i> Khu vực
          </button>
          <ul class="dropdown-menu tv-dropdown">
            <li><a class="dropdown-item" onclick="setFilter('location','Tất cả')">Tất cả</a></li>
            <li><a class="dropdown-item" onclick="setFilter('location','Hải Châu')">Hải Châu</a></li>
            <li><a class="dropdown-item" onclick="setFilter('location','Thanh Khê')">Thanh Khê</a></li>
            <li><a class="dropdown-item" onclick="setFilter('location','Sơn Trà')">Sơn Trà</a></li>
            <li><a class="dropdown-item" onclick="setFilter('location','Liên Chiểu')">Liên Chiểu</a></li>
            <li><a class="dropdown-item" onclick="setFilter('location','Ngũ Hành Sơn')">Ngũ Hành Sơn</a></li>
            <li><a class="dropdown-item" onclick="setFilter('location','Cẩm Lệ')">Cẩm Lệ</a></li>
          </ul>
        </div>

        <!-- Price -->
        <div class="dropdown">
          <button class="filter-pill" data-bs-toggle="dropdown" id="btnFilterPrice">
            <i class="bi bi-cash"></i> Giá thuê
          </button>
          <ul class="dropdown-menu tv-dropdown">
            <li><a class="dropdown-item" onclick="setFilter('price','Tất cả')">Tất cả</a></li>
            <li><a class="dropdown-item" onclick="setFilter('price','<2M')">Dưới 2 triệu</a></li>
            <li><a class="dropdown-item" onclick="setFilter('price','2M-3M')">2 - 3 triệu</a></li>
            <li><a class="dropdown-item" onclick="setFilter('price','3M-5M')">3 - 5 triệu</a></li>
            <li><a class="dropdown-item" onclick="setFilter('price','>5M')">Trên 5 triệu</a></li>
          </ul>
        </div>

        <!-- Area -->
        <div class="dropdown">
          <button class="filter-pill" data-bs-toggle="dropdown" id="btnFilterArea">
            <i class="bi bi-rulers"></i> Diện tích
          </button>
          <ul class="dropdown-menu tv-dropdown">
            <li><a class="dropdown-item" onclick="setFilter('area','Tất cả')">Tất cả</a></li>
            <li><a class="dropdown-item" onclick="setFilter('area','<20')">Dưới 20m²</a></li>
            <li><a class="dropdown-item" onclick="setFilter('area','20-30')">20 - 30m²</a></li>
            <li><a class="dropdown-item" onclick="setFilter('area','>30')">Trên 30m²</a></li>
          </ul>
        </div>

        <!-- Room Type -->
        <div class="dropdown">
          <button class="filter-pill" data-bs-toggle="dropdown" id="btnFilterStatus">
            <i class="bi bi-door-open"></i> Loại phòng
          </button>
          <ul class="dropdown-menu tv-dropdown">
            <li><a class="dropdown-item" onclick="setFilter('status','Tất cả')">Tất cả</a></li>
            <li><a class="dropdown-item" onclick="setFilter('status','Ở đơn')">Ở đơn</a></li>
            <li><a class="dropdown-item" onclick="setFilter('status','Ở ghép')">Ở ghép</a></li>
          </ul>
        </div>

        <!-- Category -->
        <div class="dropdown">
          <button class="filter-pill" data-bs-toggle="dropdown" id="btnFilterCategory">
            <i class="bi bi-lamp"></i> Nội thất
          </button>
          <ul class="dropdown-menu tv-dropdown">
            <li><a class="dropdown-item" onclick="setFilter('category','Tất cả')">Tất cả</a></li>
            <li><a class="dropdown-item" onclick="setFilter('category','Nội thất đầy đủ')">Nội thất đầy đủ</a></li>
            <li><a class="dropdown-item" onclick="setFilter('category','Nội thất cơ bản')">Nội thất cơ bản</a></li>
            <li><a class="dropdown-item" onclick="setFilter('category','Nhà trống')">Nhà trống</a></li>
          </ul>
        </div>

        <!-- Sort -->
        <div class="dropdown ms-auto">
          <button class="filter-pill" data-bs-toggle="dropdown" id="sortByBtn">
            <i class="bi bi-arrow-down-up"></i> Tin mới nhất
          </button>
          <ul class="dropdown-menu dropdown-menu-end tv-dropdown">
            <li><a class="dropdown-item" id="sort-newest" onclick="setSort('newest')">Tin mới nhất <i class="bi bi-check2 ms-auto"></i></a></li>
            <li><a class="dropdown-item" id="sort-price-asc" onclick="setSort('price-asc')">Giá thấp trước <i class="bi bi-check2 ms-auto d-none"></i></a></li>
            <li><a class="dropdown-item" id="sort-price-desc" onclick="setSort('price-desc')">Giá cao trước <i class="bi bi-check2 ms-auto d-none"></i></a></li>
          </ul>
        </div>
      </div>

      <!-- Amenities Filter -->
      <div class="tv-amenity-filters">
        <% if (typeof AMENITIES !== 'undefined') { %>
          <% AMENITIES.forEach(a => { %>
            <button class="amenity-chip" data-amenity="<%= a.key %>" onclick="toggleAmenityFilter(this, '<%= a.key %>')">
              <i class="bi <%= a.icon %>"></i> <%= a.label %>
            </button>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>

  <!-- ========== MAIN CONTENT ========== -->
  <main class="tv-main">
    <div class="container">
      <!-- Results Header -->
      <div class="tv-results-header">
        <p class="tv-results-count">
          <strong id="statRoomCount"><%= rooms.length %></strong> phòng trọ tại Đà Nẵng
        </p>
      </div>

      <!-- Room Cards Grid -->
      <div class="tv-rooms-grid" id="roomsContainer">
        <% rooms.forEach(room => { %>
        <div class="tv-room-card room-card"
             data-id="<%= room.id %>"
             data-title="<%= room.title %>"
             data-address="<%= room.address %>"
             data-price="<%= room.price %>"
             data-area="<%= room.area %>"
             data-category="<%= room.category %>"
             data-status="<%= room.status %>"
             data-created-at="<%= room.createdAt || '' %>"
             data-amenities="<%= room.amenities ? room.amenities.join(',') : '' %>"
             data-room="<%= encodeURIComponent(JSON.stringify(room)) %>"
             onclick="handleCardClick(event, this)">

          <div class="tv-card-img">
            <img src="<%= room.images && room.images.length > 0 ? room.images[0] : 'https://images.unsplash.com/photo-1522771739844-6a9f6d5f14af?auto=format&fit=crop&w=400&h=280&q=80' %>" alt="<%= room.title %>" loading="lazy">
            <% if (room.isAvailable !== false) { %>
              <span class="tv-badge-available">Còn trống</span>
            <% } else { %>
              <span class="tv-badge-rented">Đã thuê</span>
            <% } %>
            <button class="tv-fav-btn btn-fav-toggle" data-fav-id="<%= room.id %>" onclick="toggleFavorite(event, '<%= room.id %>')">
              <i class="bi bi-heart text-secondary"></i>
            </button>
          </div>

          <div class="tv-card-body">
            <div class="tv-card-price">
              <%= room.price ? (room.price / 1000000).toLocaleString('vi-VN') : 0 %> triệu/tháng
            </div>
            <h3 class="tv-card-title truncate-2"><%= room.title %></h3>
            <div class="tv-card-location">
              <i class="bi bi-geo-alt-fill"></i>
              <span class="truncate-2"><%= room.address %></span>
            </div>
            <div class="tv-card-tags">
              <span class="tv-tag"><i class="bi bi-rulers"></i> <%= room.area || 0 %> m²</span>
              <span class="tv-tag"><i class="bi bi-grid"></i> <%= room.category || 'Cơ bản' %></span>
              <span class="tv-tag"><i class="bi bi-door-open"></i> <%= room.status || 'Ở đơn' %></span>
            </div>
            <% if (room.amenities && room.amenities.length > 0) { %>
            <div class="tv-card-amenities">
              <% const displayAmenities = room.amenities.slice(0, 3); %>
              <% displayAmenities.forEach(ak => { %>
                <% const found = typeof AMENITIES !== 'undefined' ? AMENITIES.find(a => a.key === ak) : null; %>
                <% if (found) { %>
                  <span class="tv-amenity-mini"><i class="bi <%= found.icon %>"></i> <%= found.label %></span>
                <% } %>
              <% }) %>
              <% if (room.amenities.length > 3) { %>
                <span class="tv-amenity-mini tv-amenity-more">+<%= room.amenities.length - 3 %></span>
              <% } %>
            </div>
            <% } %>
            <div class="tv-card-footer">
              <span class="tv-card-time posting-time-el" data-created="<%= room.createdAt %>">Vừa xong</span>
              <span class="tv-card-host"><i class="bi bi-person"></i> <%= room.host && room.host.username ? room.host.username : 'Ẩn danh' %></span>
            </div>
          </div>
        </div>
        <% }) %>

        <!-- Empty Placeholder -->
        <div id="emptyPlaceholder" class="tv-empty-state" style="display: none;">
          <i class="bi bi-search"></i>
          <h4>Không tìm thấy phòng trọ</h4>
          <p>Thử thay đổi bộ lọc hoặc từ khóa tìm kiếm</p>
          <button class="btn-tv btn-tv-outline" onclick="resetAllFilters()">Xóa bộ lọc</button>
        </div>
      </div>

      <!-- Pagination -->
      <div class="tv-pagination" id="paginationContainer"></div>
    </div>
  </main>

  <!-- ========== ROOM DETAIL MODAL ========== -->
  <div class="modal fade" id="roomDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content tv-modal-content position-relative">
        <!-- Close Button -->
        <button type="button" class="btn-close tv-modal-close-btn" data-bs-dismiss="modal" aria-label="Close"></button>

        <!-- Carousel -->
        <div class="tv-modal-carousel" id="detailCarousel">
          <div id="carouselInner" class="carousel-inner"></div>
          <button class="carousel-control-prev" type="button" data-bs-target="#detailCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
          </button>
          <button class="carousel-control-next" type="button" data-bs-target="#detailCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
          </button>
        </div>
        <div class="carousel-thumbnails" id="carouselThumbnails" style="display: none;"></div>

        <div class="modal-body tv-modal-body">
          <!-- Status & Save -->
          <div class="d-flex align-items-center justify-content-between mb-3">
            <span id="detailBadgeStatus" class="badge-tv badge-tv-success">Còn trống</span>
            <button class="btn-tv btn-tv-ghost btn-tv-sm btn-fav-toggle" id="detailFavBtn">
              <i class="bi bi-heart text-secondary"></i> Lưu tin
            </button>
          </div>

          <!-- Price -->
          <div class="tv-detail-price" id="detailPrice">0 triệu/tháng</div>
          <span class="badge-tv badge-tv-neutral mb-3" id="detailDepositBadge" style="display:none">
            <i class="bi bi-shield-check"></i> Cọc: <span id="detailDeposit">0</span>đ
          </span>

          <!-- Title -->
          <h2 class="tv-detail-title" id="detailTitle">Tiêu đề</h2>

          <!-- Location -->
          <div class="tv-detail-location mb-4">
            <i class="bi bi-geo-alt-fill text-danger"></i>
            <span id="detailAddress">Địa chỉ</span>
          </div>

          <!-- Info Grid -->
          <div class="tv-detail-info-grid mb-4">
            <div class="tv-info-item">
              <i class="bi bi-rulers"></i>
              <div>
                <span class="tv-info-label">Diện tích</span>
                <span class="tv-info-value"><span id="detailArea">0</span> m²</span>
              </div>
            </div>
            <div class="tv-info-item">
              <i class="bi bi-grid"></i>
              <div>
                <span class="tv-info-label">Nội thất</span>
                <span class="tv-info-value" id="detailCategory">Cơ bản</span>
              </div>
            </div>
            <div class="tv-info-item">
              <i class="bi bi-door-open"></i>
              <div>
                <span class="tv-info-label">Loại phòng</span>
                <span class="tv-info-value" id="detailStatus">Ở đơn</span>
              </div>
            </div>
            <div class="tv-info-item">
              <i class="bi bi-calendar3"></i>
              <div>
                <span class="tv-info-label">Cọc trước</span>
                <span class="tv-info-value" id="detailDepositMonth">Chưa cập nhật</span>
              </div>
            </div>
            <div class="tv-info-item">
              <i class="bi bi-repeat"></i>
              <div>
                <span class="tv-info-label">Chu kỳ trả</span>
                <span class="tv-info-value" id="detailPaymentCycle">Chưa cập nhật</span>
              </div>
            </div>
            <div class="tv-info-item">
              <i class="bi bi-p-circle"></i>
              <div>
                <span class="tv-info-label">Chỗ để xe</span>
                <span class="tv-info-value" id="detailParking">Chưa cập nhật</span>
              </div>
            </div>
          </div>

          <!-- Utility Costs -->
          <div class="tv-detail-costs mb-4">
            <div class="tv-cost-item">
              <i class="bi bi-lightning-charge text-warning"></i>
              <span>Điện: <strong id="detailElectricity">Chưa cập nhật</strong></span>
            </div>
            <div class="tv-cost-item">
              <i class="bi bi-droplet text-primary"></i>
              <span>Nước: <strong id="detailWater">Chưa cập nhật</strong></span>
            </div>
          </div>

          <!-- Amenities -->
          <div class="tv-detail-amenities mb-4" id="detailAmenities" style="display:none">
            <h6 class="tv-detail-section-title">Tiện ích</h6>
            <div class="tv-amenities-grid" id="detailAmenitiesList"></div>
          </div>

          <!-- Description -->
          <div class="tv-detail-description mb-4">
            <h6 class="tv-detail-section-title">Mô tả</h6>
            <p id="detailDescription">Mô tả phòng trọ</p>
          </div>

          <!-- Host Info -->
          <div class="tv-detail-host">
            <div class="tv-host-info">
              <div class="tv-host-avatar">
                <i class="bi bi-person-circle"></i>
              </div>
              <div>
                <strong id="detailHostName">Chủ trọ</strong>
                <span id="detailHostRole">Cá nhân</span>
              </div>
            </div>
            <div class="d-flex flex-column flex-sm-row gap-2">
              <a href="tel:" class="btn-tv btn-tv-success btn-tv-sm" id="btnCallHost">
                <i class="bi bi-telephone"></i> <span id="detailPhone">SĐT</span>
              </a>
              <a href="#" target="_blank" class="btn-tv btn-tv-primary btn-tv-sm" id="btnZaloHost">
                <i class="bi bi-chat-dots"></i> Nhắn Zalo
              </a>
            </div>
          </div>

          <!-- Posting Time -->
          <div class="tv-detail-time mt-3" id="detailPostingTime">
            <i class="bi bi-clock me-1"></i>Vừa xong
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast -->
  <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1060;">
    <div id="favToast" class="toast align-items-center border-0 rounded-3 toast-tv" role="alert" style="background: var(--color-text); color: #fff;">
      <div class="d-flex">
        <div class="toast-body" id="favToastBody">Đã lưu!</div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
      </div>
    </div>
  </div>

  <!-- Pass data to JS -->
  <script>
    <% if (user) { %>
      const LOGGED_IN_USER_ID = '<%= user.id %>';
      const INITIAL_FAVORITES = <%- JSON.stringify(user.favorites || []) %>;
    <% } else { %>
      const LOGGED_IN_USER_ID = '';
      const INITIAL_FAVORITES = [];
    <% } %>
    const AMENITIES_DATA = <%- JSON.stringify(typeof AMENITIES !== 'undefined' ? AMENITIES : []) %>;
  </script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/rooms/index.js"></script>
</body>
</html>