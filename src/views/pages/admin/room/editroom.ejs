<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chỉnh sửa tin đăng - TrọVíp</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin/newrooms.css">
</head>

<body>
    <div class="wrapper pb-5">
        <!-- Back to dashboard link -->
        <% 
            let backUrl = '/rooms/dashboard';
            if (user && user.role === ROLES.ADMIN) backUrl = '/admin';
        %>
        <div class="mb-4 d-flex align-items-center">
            <a href="<%= backUrl %>" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-left"></i> Quay lại Dashboard
            </a>
        </div>

        <form action="/rooms/edit/<%= room.id %>" method="POST" enctype="multipart/form-data" id="roomForm" novalidate>
            <!-- Error Alert -->
            <% if (typeof error !== 'undefined' && error) { %>
              <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
              </div>
            <% } %>

            <!-- Vị trí bất động sản -->
            <div class="custom-card">
                <h2 class="card-title">Vị trí bất động sản</h2>

                <div class="form-group floating-label" id="addressGroup">
                    <select class="custom-input has-value" name="address" required id="addressInput">
                        <option value="" disabled></option>
                        <option value="Hải Châu - Đà Nẵng" <%= room.address === 'Hải Châu - Đà Nẵng' ? 'selected' : '' %>>Hải Châu - Đà Nẵng</option>
                        <option value="Thanh Khê - Đà Nẵng" <%= room.address === 'Thanh Khê - Đà Nẵng' ? 'selected' : '' %>>Thanh Khê - Đà Nẵng</option>
                        <option value="Sơn Trà - Đà Nẵng" <%= room.address === 'Sơn Trà - Đà Nẵng' ? 'selected' : '' %>>Sơn Trà - Đà Nẵng</option>
                        <option value="Ngũ Hành Sơn - Đà Nẵng" <%= room.address === 'Ngũ Hành Sơn - Đà Nẵng' ? 'selected' : '' %>>Ngũ Hành Sơn - Đà Nẵng</option>
                    </select>
                    <label>Địa chỉ <span>*</span></label>
                    <div class="error-msg">Vui lòng chọn địa chỉ bất động sản</div>
                </div>
            </div>

            <!-- Đặc điểm bất động sản -->
            <div class="custom-card">
                <h2 class="card-title">Đặc điểm bất động sản</h2>

                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="form-group floating-label" id="areaGroup">
                            <input type="number" class="custom-input has-value" name="area" placeholder="VD: 25" required id="areaInput" min="1" value="<%= room.area %>">
                            <label>Diện tích (m²) <span>*</span></label>
                            <div class="error-msg">Diện tích phải lớn hơn 0</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group floating-label">
                            <select class="custom-input has-value" name="category" id="categoryInput">
                                <option value="" disabled></option>
                                <option value="Nội thất cơ bản" <%= room.category === 'Nội thất cơ bản' ? 'selected' : '' %>>Nội thất cơ bản</option>
                                <option value="Nội thất đầy đủ" <%= room.category === 'Nội thất đầy đủ' ? 'selected' : '' %>>Nội thất đầy đủ</option>
                                <option value="Nhà trống" <%= room.category === 'Nhà trống' ? 'selected' : '' %>>Nhà trống</option>
                            </select>
                            <label>Tình trạng nội thất</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group floating-label" id="statusGroup">
                            <select class="custom-input has-value" name="status" required id="statusInput">
                                <option value="" disabled></option>
                                <option value="Ở đơn" <%= room.status === 'Ở đơn' ? 'selected' : '' %>>Ở đơn</option>
                                <option value="Ở ghép" <%= room.status === 'Ở ghép' ? 'selected' : '' %>>Ở ghép</option>
                            </select>
                            <label>Loại phòng <span>*</span></label>
                            <div class="error-msg">Vui lòng chọn loại phòng</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Nội dung tin đăng -->
            <div class="custom-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="card-title mb-0">Nội dung tin đăng</h2>
                </div>

                <!-- Preview current images -->
                <% if (room.images && room.images.length > 0) { %>
                    <div class="mb-3 p-3 bg-light rounded border" id="currentImagesPreview">
                        <span class="d-block mb-2 text-secondary fw-semibold" style="font-size: 14px;">Ảnh hiện tại của tin đăng:</span>
                        <div class="d-flex flex-wrap gap-2">
                            <% room.images.forEach(img => { %>
                                <img src="<%= img %>" class="rounded border" style="width: 70px; height: 50px; object-fit: cover;">
                            <% }) %>
                        </div>
                        <small class="text-muted d-block mt-2" style="font-size: 12px;"><i class="bi bi-info-circle"></i> Nếu bạn tải lên ảnh mới bên dưới, toàn bộ ảnh hiện tại sẽ được thay thế.</small>
                    </div>
                <% } %>

                <div class="form-group mb-4" id="uploadGroup">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="fw-medium text-dark" style="font-size: 15px;">Thay đổi hình ảnh/video <span>(Tùy chọn)</span></span>
                        <i class="bi bi-info-circle text-dark" title="Hỗ trợ JPG, PNG, WEBP"></i>
                    </div>

                    <div class="upload-area" id="uploadArea">
                        <input type="file" name="images" id="fileInput" multiple accept="image/*">
                        <div class="upload-content">
                            <i class="bi bi-images upload-icon"></i>
                            <div class="upload-text">Thêm ảnh mới thay thế ảnh cũ</div>
                        </div>
                    </div>
                    <div class="error-msg mt-2">Vui lòng tải lên ảnh hợp lệ</div>
                </div>

                <div class="form-group floating-label" id="titleGroup">
                    <input type="text" class="custom-input has-value" name="title" required minlength="10" maxlength="70" placeholder=" " id="titleInput" value="<%= room.title %>">
                    <label>Tiêu đề tin đăng <span>*</span></label>
                    <div class="char-count" id="titleCharCount">0/70 kí tự</div>
                    <div class="error-msg">Tiêu đề phải từ 10 đến 70 ký tự</div>
                </div>

                <div class="form-group floating-label" id="priceGroup">
                    <div class="input-with-suffix">
                        <input type="number" class="custom-input has-value" name="price" required placeholder=" " id="priceInput" min="1" value="<%= room.price %>">
                        <label>Giá thuê <span>*</span></label>
                        <span class="suffix">đ</span>
                    </div>
                    <div class="error-msg">Giá thuê phải lớn hơn 0</div>
                </div>

                <div class="form-group floating-label" id="depositGroup">
                    <div class="input-with-suffix">
                        <input type="number" class="custom-input has-value" name="deposit" placeholder=" " id="depositInput" min="0" value="<%= room.deposit %>">
                        <label>Số tiền cọc</label>
                        <span class="suffix">đ</span>
                    </div>
                    <div class="error-msg">Tiền đặt cọc không được là số âm</div>
                </div>

                <div class="form-group floating-label" id="phoneGroup">
                    <input type="tel" class="custom-input has-value" name="phone" required placeholder=" " id="phoneInput" value="<%= room.phone || '' %>">
                    <label>Số điện thoại liên hệ <span>*</span></label>
                    <div class="error-msg">Số điện thoại không hợp lệ (phải là số Việt Nam gồm 10 chữ số bắt đầu bằng số 0)</div>
                </div>

                <div class="form-group floating-label" id="descriptionGroup">
                    <textarea class="custom-input has-value" name="description" rows="5" required minlength="30" maxlength="1500"
                        placeholder=" " id="descriptionInput"><%= room.description %></textarea>
                    <label>Mô tả chi tiết phòng trọ <span>*</span></label>
                    <div class="char-count" id="descCharCount">0/1500 kí tự</div>
                    <div class="error-msg">Mô tả chi tiết phòng trọ phải dài ít nhất 30 ký tự</div>
                </div>
            </div>

            <!-- Sticky Bottom Bar -->
            <div class="action-bar">
                <div class="wrapper d-flex gap-3 py-3" style="margin: 0 auto;">
                    <a href="<%= backUrl %>" class="btn-cancel flex-fill text-center d-flex align-items-center justify-content-center">Hủy bỏ</a>
                    <button type="submit" class="btn-submit flex-fill">Cập nhật tin đăng</button>
                </div>
            </div>

        </form>
    </div>

    <!-- Toast container for client validations -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1060;">
        <div id="errorToast" class="toast align-items-center text-bg-danger border-0 rounded-3" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    ⚠️ Vui lòng sửa các lỗi nhập liệu trước khi lưu tin đăng!
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/rooms/roomFormValidation.js"></script>
</body>

</html>
