<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng tin - TrọVíp</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin/newrooms.css">
</head>

<body>
    <div class="wrapper pb-5">
        <!-- Back to dashboard link -->
        <div class="mb-4 d-flex align-items-center">
            <a href="<%= user && user.role === ROLES.ADMIN ? '/admin' : '/rooms/dashboard' %>"
                class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-left"></i> Quay lại Dashboard
            </a>
        </div>

        <form action="/rooms/create" method="POST" enctype="multipart/form-data" id="roomForm" novalidate>
            <!-- Error Alert -->
            <% if (typeof error !=='undefined' && error) { %>
                <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <%= error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                <% } %>

                    <!-- Vị trí phòng trọ -->
                    <div class="custom-card">
                        <h2 class="card-title">Vị trí phòng trọ</h2>

                        <% const danangWards={ 'Hải Châu' : [ 'Phường Hòa Cường Bắc, Quận Hải Châu'
                            , 'Phường Hòa Cường Nam, Quận Hải Châu' , 'Phường Hòa Thuận Đông, Quận Hải Châu'
                            , 'Phường Hòa Thuận Tây, Quận Hải Châu' , 'Phường Hải Châu I, Quận Hải Châu'
                            , 'Phường Hải Châu II, Quận Hải Châu' , 'Phường Phước Ninh, Quận Hải Châu'
                            , 'Phường Nam Dương, Quận Hải Châu' , 'Phường Thạch Thang, Quận Hải Châu'
                            , 'Phường Thanh Bình, Quận Hải Châu' , 'Phường Thuận Phước, Quận Hải Châu'
                            , 'Phường Bình Thuận, Quận Hải Châu' , 'Phường Bình Hiên, Quận Hải Châu' ], 'Thanh Khê' :
                            [ 'Phường Thạc Gián, Quận Thanh Khê' , 'Phường Vĩnh Trung, Quận Thanh Khê'
                            , 'Phường Tân Lập, Quận Thanh Khê' , 'Phường Chính Gián, Quận Thanh Khê'
                            , 'Phường Tam Thuận, Quận Thanh Khê' , 'Phường Xuân Hà, Quận Thanh Khê'
                            , 'Phường An Khê, Quận Thanh Khê' , 'Phường Hòa Khê, Quận Thanh Khê'
                            , 'Phường Thanh Khê Đông, Quận Thanh Khê' , 'Phường Thanh Khê Tây, Quận Thanh Khê'
                            ], 'Sơn Trà' : [ 'Phường An Hải Bắc, Quận Sơn Trà' , 'Phường An Hải Tây, Quận Sơn Trà'
                            , 'Phường An Hải Đông, Quận Sơn Trà' , 'Phường Phước Mỹ, Quận Sơn Trà'
                            , 'Phường Mân Thái, Quận Sơn Trà' , 'Phường Nại Hiên Đông, Quận Sơn Trà'
                            , 'Phường Thọ Quang, Quận Sơn Trà' ], 'Ngũ Hành Sơn' : [ 'Phường Mỹ An, Quận Ngũ Hành Sơn'
                            , 'Phường Khuê Mỹ, Quận Ngũ Hành Sơn' , 'Phường Hòa Hải, Quận Ngũ Hành Sơn'
                            , 'Phường Hòa Quý, Quận Ngũ Hành Sơn' ], 'Liên Chiểu' : [ 'Phường Hòa Minh, Quận Liên Chiểu'
                            , 'Phường Hòa Khánh Nam, Quận Liên Chiểu' , 'Phường Hòa Khánh Bắc, Quận Liên Chiểu'
                            , 'Phường Hòa Hiệp Nam, Quận Liên Chiểu' , 'Phường Hòa Hiệp Bắc, Quận Liên Chiểu'
                            ], 'Cẩm Lệ' : [ 'Phường Khuê Trung, Quận Cẩm Lệ' , 'Phường Hòa An, Quận Cẩm Lệ'
                            , 'Phường Hòa Phát, Quận Cẩm Lệ' , 'Phường Hòa Thọ Đông, Quận Cẩm Lệ'
                            , 'Phường Hòa Thọ Tây, Quận Cẩm Lệ' , 'Phường Hòa Xuân, Quận Cẩm Lệ' ] }; %>

                            <div class="form-group floating-label" id="addressGroup">
                                <select class="custom-input" name="address" required id="addressInput">
                                    <option value="" selected disabled></option>
                                    <% for (const [district, wards] of Object.entries(danangWards)) { %>
                                        <optgroup label="Quận <%= district %>">
                                            <% wards.forEach(ward=> { %>
                                                <option value="<%= ward %>">
                                                    <%= ward %>
                                                </option>
                                                <% }) %>
                                        </optgroup>
                                        <% } %>
                                </select>
                                <label>Địa chỉ <span>*</span></label>
                                <div class="error-msg">Vui lòng chọn địa chỉ phòng trọ</div>
                            </div>
                    </div>

                    <!-- Đặc điểm phòng trọ -->
                    <div class="custom-card">
                        <h2 class="card-title">Đặc điểm phòng trọ</h2>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="form-group floating-label" id="areaGroup">
                                    <input type="number" class="custom-input" name="area" placeholder=" " required
                                        id="areaInput" min="1">
                                    <label>Diện tích (m²) <span>*</span></label>
                                    <div class="error-msg">Diện tích phải lớn hơn 0</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group floating-label">
                                    <select class="custom-input" name="category" id="categoryInput">
                                        <option value="" selected disabled></option>
                                        <option value="Nội thất cơ bản">Nội thất cơ bản</option>
                                        <option value="Nội thất đầy đủ">Nội thất đầy đủ</option>
                                        <option value="Nhà trống">Nhà trống</option>
                                    </select>
                                    <label>Tình trạng nội thất</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group floating-label" id="statusGroup">
                                    <select class="custom-input" name="status" required id="statusInput">
                                        <option value="" selected disabled></option>
                                        <option value="Ở đơn">Ở đơn</option>
                                        <option value="Ở ghép">Ở ghép</option>
                                    </select>
                                    <label>Loại phòng <span>*</span></label>
                                    <div class="error-msg">Vui lòng chọn loại phòng</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Quy định & Chi phí khác -->
                    <div class="custom-card">
                        <h2 class="card-title">Quy định & Chi phí</h2>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-group floating-label" id="depositMonthGroup">
                                    <input type="number" class="custom-input" name="depositMonth" placeholder=" "
                                        min="0" step="0.1" id="depositMonthInput">
                                    <label>Số tháng cọc trước (tháng)</label>
                                    <div class="error-msg">Số tháng cọc trước không được là số âm</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group floating-label" id="paymentCycleGroup">
                                    <input type="text" class="custom-input" name="paymentCycle" placeholder=" "
                                        id="paymentCycleInput">
                                    <label>Chu kỳ trả tiền (VD: 1 tháng/lần)</label>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group floating-label" id="parkingGroup">
                                    <select class="custom-input" name="parking" id="parkingInput">
                                        <option value="" selected disabled></option>
                                        <option value="Có">Có</option>
                                        <option value="Không">Không</option>
                                    </select>
                                    <label>Chỗ để xe</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group floating-label" id="electricityPriceGroup">
                                    <div class="input-with-suffix">
                                        <input type="number" class="custom-input" name="electricityPrice"
                                            placeholder=" " min="0" id="electricityPriceInput">
                                        <label>Tiền điện (đ/kWh)</label>
                                        <span class="suffix">đ/kWh</span>
                                    </div>
                                    <div class="error-msg">Tiền điện không được là số âm</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group floating-label" id="waterPriceGroup">
                                    <div class="input-with-suffix">
                                        <input type="number" class="custom-input" name="waterPrice" placeholder=" "
                                            min="0" id="waterPriceInput">
                                        <label>Tiền nước (đ/m³)</label>
                                        <span class="suffix">đ/m³</span>
                                    </div>
                                    <div class="error-msg">Tiền nước không được là số âm</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Nội dung tin đăng -->
                    <div class="custom-card">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h2 class="card-title mb-0">Nội dung tin đăng</h2>
                        </div>

                        <!-- Image Upload -->
                        <div class="form-group mb-4" id="uploadGroup">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="fw-medium text-dark" style="font-size: 15px;">Hình ảnh phòng trọ <span
                                        style="color:#ef4444;">*</span></span>
                            </div>

                            <!-- Beautiful Upload Area -->
                            <div class="upload-area" id="uploadArea">
                                <input type="file" id="fileInput" multiple accept="image/*" style="display: none;">
                                <div class="upload-content" id="uploadContent">
                                    <i class="bi bi-images upload-icon"></i>
                                    <div class="upload-text">Chọn hình ảnh hoặc kéo thả vào đây</div>
                                    <small class="text-muted" style="font-size: 0.8rem;">Hỗ trợ: JPG, PNG, WEBP</small>
                                </div>
                            </div>

                            <!-- Container to show selected image previews -->
                            <div id="imagePreviewsContainer" class="d-flex flex-wrap gap-2 mt-3"></div>

                            <!-- The "+ Thêm ảnh khác" button to add more images -->
                            <button type="button" class="btn btn-primary btn-sm mt-2 fw-semibold" id="addMoreImagesBtn">
                                <i class="bi bi-plus-lg"></i> Thêm ảnh khác
                            </button>

                            <!-- Hidden input that actually submits ALL collected files -->
                            <input type="file" name="images" id="finalImagesInput" multiple accept="image/*"
                                style="display: none;" required>

                            <div class="error-msg mt-2">Vui lòng tải lên ít nhất 1 ảnh phòng trọ</div>
                        </div>

                        <!-- Title -->
                        <div class="form-group floating-label" id="titleGroup">
                            <input type="text" class="custom-input" name="title" required minlength="10" maxlength="70"
                                placeholder=" " id="titleInput">
                            <label>Tiêu đề tin đăng <span>*</span></label>
                            <div class="char-count" id="titleCharCount">0/70 kí tự</div>
                            <div class="error-msg">Tiêu đề phải từ 10 đến 70 ký tự</div>
                        </div>

                        <!-- Price -->
                        <div class="form-group floating-label" id="priceGroup">
                            <div class="input-with-suffix">
                                <input type="number" class="custom-input" name="price" required placeholder=" "
                                    id="priceInput" min="1">
                                <label>Giá thuê <span>*</span></label>
                                <span class="suffix">đ</span>
                            </div>
                            <div class="error-msg">Giá thuê phải lớn hơn 0</div>
                        </div>

                        <!-- Deposit -->
                        <div class="form-group floating-label" id="depositGroup">
                            <div class="input-with-suffix">
                                <input type="number" class="custom-input" name="deposit" placeholder=" "
                                    id="depositInput" min="0">
                                <label>Số tiền cọc</label>
                                <span class="suffix">đ</span>
                            </div>
                            <div class="error-msg">Tiền đặt cọc không được là số âm</div>
                        </div>

                        <!-- Phone -->
                        <div class="form-group floating-label" id="phoneGroup">
                            <input type="tel" class="custom-input" name="phone" required placeholder=" "
                                id="phoneInput">
                            <label>Số điện thoại liên hệ <span>*</span></label>
                            <div class="error-msg">Số điện thoại không hợp lệ</div>
                        </div>

                        <!-- Description -->
                        <div class="form-group floating-label" id="descriptionGroup">
                            <textarea class="custom-input" name="description" rows="5" required minlength="30"
                                maxlength="1500" placeholder=" " id="descriptionInput"></textarea>
                            <label>Mô tả chi tiết phòng trọ (<span id="descCharCount">0</span>/1500 kí tự) <span>*</span></label>
                            <div class="error-msg">Mô tả phòng phải dài ít nhất 30 ký tự</div>
                        </div>
                    </div>

                    <!-- Sticky Bottom Bar -->
                    <div class="action-bar">
                        <div class="wrapper d-flex gap-3 py-3" style="margin: 0 auto;">
                            <a href="<%= user && user.role === ROLES.ADMIN ? '/admin' : '/rooms/dashboard' %>"
                                class="btn-cancel flex-fill text-center d-flex align-items-center justify-content-center">Hủy
                                bỏ</a>
                            <button type="submit" class="btn-submit flex-fill">Đăng tin phòng trọ</button>
                        </div>
                    </div>

        </form>
    </div>

    <!-- Toast container for client validations -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1060;">
        <div id="errorToast" class="toast align-items-center text-bg-danger border-0 rounded-3" role="alert"
            aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    ⚠️ Vui lòng sửa các lỗi nhập liệu trước khi đăng tin!
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/rooms/roomFormValidation.js"></script>
</body>

</html>