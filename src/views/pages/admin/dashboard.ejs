<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/design-system.css">
  <link rel="stylesheet" href="/css/admin/dashboard.css">
</head>
<body>

<div class="container-fluid p-0">
  <div class="dashboard-container">
    <!-- Sidebar -->
    <%- include('../../components/sidebarAdmin', { activeTab: 'dashboard' }) %>

    <!-- Main Content -->
    <div class="db-main">
      <!-- Header -->
      <div class="db-header">
        <div>
          <h1 class="db-title">Bảng điều khiển Admin</h1>
          <p class="db-subtitle">Xin chào, <strong><%= user.username %></strong> | Quyền quản trị hệ thống</p>
        </div>
        <div class="dropdown">
          <button class="btn btn-white border dropdown-toggle rounded px-3" type="button" data-bs-toggle="dropdown">
            <i class="bi bi-person me-2 text-secondary"></i> <%= user.username %> (Admin)
          </button>
          <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2">
            <li><a class="dropdown-item" href="/rooms"><i class="bi bi-house me-2 text-muted"></i>Trang chủ</a></li>
            <li><a class="dropdown-item" href="/users/change-password"><i class="bi bi-key me-2 text-muted"></i>Đổi mật khẩu</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item text-danger" href="/users/logout"><i class="bi bi-box-arrow-left me-2"></i>Đăng xuất</a></li>
          </ul>
        </div>
      </div>

      <!-- Stats Cards -->
      <%
        let totalUsers = users.length;
        let totalRooms = rooms.length;
        let availableRooms = rooms.filter(r => r.isAvailable !== false).length;
        let rentedRooms = totalRooms - availableRooms;
      %>
      <div class="db-stats-grid">
        <div class="db-stat-card">
          <div>
            <div class="db-stat-label">Tổng người dùng</div>
            <div class="db-stat-value"><%= totalUsers %></div>
            <div class="db-stat-trend text-primary">Tài khoản hoạt động</div>
          </div>
          <div class="db-stat-icon blue">
            <i class="bi bi-people-fill"></i>
          </div>
        </div>

        <div class="db-stat-card">
          <div>
            <div class="db-stat-label">Tổng phòng đăng</div>
            <div class="db-stat-value"><%= totalRooms %></div>
            <div class="db-stat-trend">Trên toàn hệ thống</div>
          </div>
          <div class="db-stat-icon green">
            <i class="bi bi-house-door-fill"></i>
          </div>
        </div>

        <div class="db-stat-card">
          <div>
            <div class="db-stat-label">Phòng đang trống</div>
            <div class="db-stat-value"><%= availableRooms %></div>
            <div class="db-stat-trend text-warning">Chờ khách thuê</div>
          </div>
          <div class="db-stat-icon orange">
            <i class="bi bi-door-open-fill"></i>
          </div>
        </div>

        <div class="db-stat-card">
          <div>
            <div class="db-stat-label">Phòng đã thuê</div>
            <div class="db-stat-value"><%= rentedRooms %></div>
            <div class="db-stat-trend text-danger">Đã có hợp đồng</div>
          </div>
          <div class="db-stat-icon red">
            <i class="bi bi-door-closed-fill"></i>
          </div>
        </div>
      </div>

      <!-- Navigation Tabs -->
      <div class="db-tabs">
        <button class="db-tab-btn active" id="rooms-tab" data-bs-toggle="tab" data-bs-target="#rooms-pane" type="button" role="tab"><i class="bi bi-house-fill me-1"></i> Quản lý phòng trọ</button>
        <button class="db-tab-btn" id="users-tab" data-bs-toggle="tab" data-bs-target="#users-pane" type="button" role="tab"><i class="bi bi-people-fill me-1"></i> Quản lý người dùng</button>
      </div>

      <!-- Tabs Contents -->
      <div class="tab-content" id="adminTabsContent">
        
        <!-- ROOMS PANE -->
        <div class="tab-pane fade show active" id="rooms-pane" role="tabpanel">
          <div class="db-card">
            <div class="db-card-header flex-wrap gap-2">
              <h5 class="db-card-title">Danh sách tin đăng phòng trọ</h5>
              <div class="d-flex align-items-center gap-2">
                <span class="text-secondary small fw-medium text-nowrap">Trạng thái:</span>
                <select class="form-select form-select-sm border" id="statusFilter" style="width: 130px; font-size: 0.85rem;" onchange="filterDashboardRooms()">
                  <option value="all">Tất cả</option>
                  <option value="available">Còn trống</option>
                  <option value="rented">Đã thuê</option>
                </select>
              </div>
            </div>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0 table-tv">
                <thead>
                  <tr>
                    <th class="ps-3" style="width: 100px;">Hình ảnh</th>
                    <th>Tiêu đề / Địa chỉ</th>
                    <th>Giá / Diện tích</th>
                    <th>Người đăng</th>
                    <th class="text-center text-nowrap">Trạng thái</th>
                    <th class="text-center">Hành động</th>
                  </tr>
                </thead>
                <tbody>
                  <% if(rooms && rooms.length > 0) { %>
                    <% rooms.forEach(room => { %>
                      <tr id="room-row-<%= room.id %>" data-status="<%= room.isAvailable !== false ? 'available' : 'rented' %>">
                        <td class="ps-3">
                          <img src="<%= room.images && room.images.length > 0 ? room.images[0] : 'https://images.unsplash.com/photo-1522771739844-6a9f6d5f14af?auto=format&fit=crop&w=120&h=80&q=80' %>" 
                               alt="Room thumbnail" 
                               class="rounded" 
                               style="width: 80px; height: 55px; object-fit: cover;">
                        </td>
                        <td>
                          <div class="fw-bold text-dark text-truncate" style="max-width: 250px;"><%= room.title %></div>
                          <div class="text-muted small"><i class="bi bi-geo-alt me-1"></i><%= room.address %></div>
                        </td>
                        <td>
                          <div class="fw-bold text-danger"><%= room.price ? (room.price / 1000000).toLocaleString('vi-VN') : 0 %> triệu/tháng</div>
                          <div class="text-muted small">Diện tích: <%= room.area || 0 %> m²</div>
                        </td>
                        <td>
                          <div class="fw-bold text-secondary"><%= room.host ? room.host.username : 'Ẩn danh' %></div>
                          <div class="text-muted small"><%= room.host ? room.host.role : 'Cá nhân' %></div>
                        </td>
                        <td class="text-center">
                          <% const isAvail = room.isAvailable !== false; %>
                          <span class="<%= isAvail ? 'badge-status-empty' : 'badge-status-rented' %>" 
                                id="room-badge-<%= room.id %>">
                            <%= isAvail ? 'Còn trống' : 'Đã thuê' %>
                          </span>
                        </td>
                        <td class="text-center text-nowrap">
                          <a href="/rooms/edit/<%= room.id %>" class="btn btn-sm btn-outline-primary me-2 rounded"
                             title="Chỉnh sửa tin đăng"
                             style="width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center;">
                            <i class="bi bi-pencil-square"></i>
                          </a>
                          <button class="btn btn-sm btn-outline-secondary me-2 rounded btn-action-toggle" 
                                  onclick="toggleRoomStatus('<%= room.id %>')"
                                  title="Đổi trạng thái phòng"
                                  style="width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center;">
                            <i class="bi bi-arrow-repeat"></i>
                          </button>
                          <button class="btn btn-sm btn-outline-danger rounded" 
                                  onclick="deleteRoom('<%= room.id %>')"
                                  title="Xóa tin đăng"
                                  style="width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center;">
                            <i class="bi bi-trash"></i>
                          </button>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="6" class="text-center py-5 text-muted">Chưa có phòng trọ nào được đăng.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
            
            <!-- Rooms Pagination Container -->
            <div class="d-flex justify-content-end align-items-center mt-3 mb-2 px-3 pb-3" id="roomsPaginationWrapper" style="display: none;">
              <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0" id="roomsPaginationContainer">
                </ul>
              </nav>
            </div>
          </div>
        </div>

        <!-- USERS PANE -->
        <div class="tab-pane fade" id="users-pane" role="tabpanel">
          <div class="db-card">
            <div class="db-card-header flex-wrap gap-2">
              <h5 class="db-card-title">Danh sách tài khoản người dùng</h5>
              <div class="d-flex align-items-center gap-2">
                <div class="d-flex align-items-center" style="max-width: 200px; position: relative;">
                  <i class="bi bi-search" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--color-text-muted); font-size: 0.85rem;"></i>
                  <input type="text" id="userSearchInput" class="form-control form-control-sm border" placeholder="Tìm theo tên..." oninput="filterUsers()" style="font-size: 0.85rem; padding-left: 32px !important;">
                </div>
                <select class="form-select form-select-sm border" id="userRoleFilter" onchange="filterUsers()" style="width: 140px; font-size: 0.85rem;">
                  <option value="all">Tất cả vai trò</option>
                  <option value="<%= ROLES.ADMIN %>">Quản trị viên</option>
                  <option value="<%= ROLES.LANDLORD %>">Chủ trọ</option>
                  <option value="<%= ROLES.TENANT %>">Khách thuê</option>
                </select>
              </div>
            </div>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0 table-tv">
                <thead>
                  <tr>
                    <th class="ps-4">Mã số (ID)</th>
                    <th>Tài khoản</th>
                    <th>Vai trò</th>
                    <th class="text-center">Hành động</th>
                  </tr>
                </thead>
                <tbody>
                  <% users.forEach(u => { %>
                    <tr id="user-row-<%= u.id %>" data-username="<%= u.username.toLowerCase() %>" data-role="<%= u.role %>">
                      <td class="ps-4 text-muted small">#<%= u.id %></td>
                      <td>
                        <div class="d-flex align-items-center">
                          <div class="text-primary rounded p-2 me-3 d-flex align-items-center justify-content-center" 
                               style="width: 34px; height: 34px; background: var(--color-primary-bg)">
                            <i class="bi bi-person"></i>
                          </div>
                          <div>
                            <div class="fw-bold text-dark"><%= u.username %></div>
                          </div>
                        </div>
                      </td>
                      <td>
                      <% if (u.role === ROLES.ADMIN) { %>
                          <span class="badge badge-pill-custom" style="background-color: var(--color-bg-subtle); color: var(--color-primary); border: 1px solid var(--color-border);">Quản trị viên</span>
                        <% } else if (u.role === ROLES.LANDLORD) { %>
                          <span class="badge badge-pill-custom bg-success-subtle text-success border border-success-subtle" style="padding: 4px 10px; font-size: 0.72rem; font-weight: 600; border-radius: var(--radius-sm);">Chủ trọ</span>
                        <% } else if (u.role === ROLES.TENANT) { %>
                          <span class="badge badge-pill-custom bg-info-subtle text-info border border-info-subtle" style="padding: 4px 10px; font-size: 0.72rem; font-weight: 600; border-radius: var(--radius-sm);">Khách thuê</span>
                        <% } else { %>
                          <span class="badge badge-pill-custom" style="background-color: var(--color-bg-white); color: var(--color-text-secondary); border: 1px solid var(--color-border);"><%= u.role || 'Người dùng' %></span>
                        <% } %>
                      </td>
                       <td class="text-center text-nowrap">
                        <% if (u.role === ROLES.LANDLORD) { %>
                          <button class="btn btn-sm btn-outline-primary rounded me-2" 
                                  onclick="viewLandlordRooms('<%= u.id %>', '<%= u.username %>')"
                                  title="Xem danh sách bài đăng"
                                  style="width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center;">
                            <i class="bi bi-journal-text"></i>
                          </button>
                        <% } %>
                        <button class="btn btn-sm btn-outline-danger rounded" 
                                id="btn-delete-user-<%= u.id %>"
                                onclick="deleteUser('<%= u.id %>', '<%= u.username %>')"
                                title="Xóa người dùng"
                                style="width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center;<%= u.id === user.id ? ' opacity: 0.5; cursor: not-allowed;' : '' %>"
                                <%= u.id === user.id ? 'disabled' : '' %>>
                          <i class="bi bi-trash"></i>
                        </button>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            
            <!-- Users Pagination Container -->
            <div class="d-flex justify-content-end align-items-center mt-3 mb-2 px-3 pb-3" id="usersPaginationWrapper" style="display: none;">
              <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0" id="usersPaginationContainer">
                </ul>
              </nav>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<!-- Confirm Delete Modal -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-hidden="true" style="z-index: 1060;">
  <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
    <div class="modal-content border-0 shadow-lg rounded-3">
      <div class="modal-body p-4 text-center">
        <div class="text-danger mb-3" style="font-size: 3rem;">
          <i class="bi bi-exclamation-triangle-fill"></i>
        </div>
        <h5 class="fw-bold text-dark mb-2" id="confirmDeleteTitle">Xác nhận xóa</h5>
        <p class="text-secondary small mb-4" id="confirmDeleteMessage">Bạn có chắc chắn muốn thực hiện hành động này không? Hành động này không thể hoàn tác.</p>
        <div class="d-flex justify-content-center gap-2">
          <button type="button" class="btn-tv btn-tv-outline btn-tv-sm" data-bs-dismiss="modal">Hủy</button>
          <button type="button" class="btn-tv btn-tv-danger btn-tv-sm" id="confirmDeleteBtn">Xác nhận xóa</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Landlord Rooms Modal -->
<div class="modal fade" id="landlordRoomsModal" tabindex="-1" aria-labelledby="landlordRoomsModalLabel" aria-hidden="true" style="z-index: 1060;">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg rounded-3">
      <div class="modal-header bg-light">
        <h5 class="modal-title fw-bold" id="landlordRoomsModalLabel">Bài đăng của chủ trọ</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-0">
        <div class="table-responsive" style="max-height: 450px;">
          <table class="table table-hover align-middle mb-0 table-tv">
            <thead>
              <tr>
                <th class="ps-3" style="width: 100px;">Hình ảnh</th>
                <th>Tiêu đề / Địa chỉ</th>
                <th>Giá / Diện tích</th>
                <th class="text-center">Trạng thái</th>
                <th class="text-center">Hành động</th>
              </tr>
            </thead>
            <tbody id="landlordRoomsTableBody">
              <!-- Render động bằng JS -->
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Alerts Toasts -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1060;">
  <div id="toastMessage" class="toast align-items-center text-bg-success border-0 rounded-3 toast-tv" role="alert" aria-live="assertive" aria-atomic="true">
    <div class="d-flex">
      <div class="toast-body" id="toastBody">
        Thao tác thành công!
      </div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
    </div>
  </div>
</div>

<script>
  const allRooms = <%- JSON.stringify(rooms).replace(/</g, '\\u003c') %>;
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/shared/toast.js"></script>
<script src="/js/admin/dashboard.js"></script>
</body>
</html>
