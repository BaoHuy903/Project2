<div class="col-md-2 p-0 db-sidebar border-0">
  <div class="db-sidebar-header">
    <a href="/" class="db-sidebar-brand">
      <i class="bi bi-shield-lock-fill text-danger"></i> TRỌVÍP ADMIN
    </a>
  </div>

  <% if (typeof user !== 'undefined' && user) { %>
    <div class="db-sidebar-user">
      <div class="db-sidebar-avatar">
        <%= user.username.charAt(0).toUpperCase() %>
      </div>
      <div>
        <div class="db-sidebar-username text-truncate" style="max-width: 140px;"><%= user.username %></div>
        <div class="db-sidebar-role">Admin</div>
      </div>
    </div>
  <% } %>

  <nav class="db-sidebar-nav">
    <a href="/admin" class="db-sidebar-link <%= activeTab === 'dashboard' ? 'active' : '' %>">
      <i class="bi bi-speedometer2"></i> Bảng điều khiển
    </a>
    <a href="/rooms/add" class="db-sidebar-link <%= activeTab === 'add' ? 'active' : '' %>">
      <i class="bi bi-plus-circle"></i> Đăng phòng trọ
    </a>
    <a href="/rooms" class="db-sidebar-link">
      <i class="bi bi-house"></i> Xem trang chủ
    </a>
    <a href="/users/change-password" class="db-sidebar-link <%= activeTab === 'password' ? 'active' : '' %>">
      <i class="bi bi-key"></i> Đổi mật khẩu
    </a>
    <a href="/users/logout" class="db-sidebar-link text-danger">
      <i class="bi bi-box-arrow-left"></i> Đăng xuất
    </a>
  </nav>
</div>
