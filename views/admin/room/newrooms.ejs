<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng tin - Trọ Víp</title>
    <!-- Use Bootstrap for grid and icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin/newrooms.css">
</head>

<body>
    <div class="wrapper pb-5">
        <form action="/rooms/create" method="POST" enctype="multipart/form-data">

            <!-- Vị trí bất động sản -->
            <div class="custom-card">
                <h2 class="card-title">Vị trí bất động sản</h2>

                <div class="form-group floating-label error-state">
                    <select class="custom-input" name="address" required>
                        <option value="" selected disabled></option>
                        <option value="Hải Châu - Đà Nẵng">Hải Châu - Đà Nẵng</option>
                        <option value="Thanh Khê - Đà Nẵng">Thanh Khê - Đà Nẵng</option>
                        <option value="Sơn Trà - Đà Nẵng">Sơn Trà - Đà Nẵng</option>
                        <option value="Ngũ Hành Sơn - Đà Nẵng">Ngũ Hành Sơn - Đà Nẵng</option>
                    </select>
                    <label>Địa chỉ <span>*</span></label>
                    <div class="error-msg">Vui lòng điền</div>
                </div>
            </div>

            <!-- Đặc điểm bất động sản -->
            <div class="custom-card">
                <h2 class="card-title">Đặc điểm bất động sản</h2>

                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="form-group floating-label">
                            <input type="number" class="custom-input" name="area" placeholder="VD: 25m²" required>
                            <label>Diện tích <span>*</span></label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group floating-label">
                            <select class="custom-input" name="category">
                                <option value="" selected disabled></option>
                                <option value="Nội thất cơ bản">Nội thất cơ bản</option>
                                <option value="Nội thất đầy đủ">Nội thất đầy đủ</option>
                                <option value="Nhà trống">Nhà trống</option>
                            </select>
                            <label>Tình trạng nội thất</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group floating-label">
                            <select class="custom-input" name="status" required>
                                <option value="" selected disabled></option>
                                <option value="Ở đơn">Ở đơn</option>
                                <option value="Ở ghép">Ở ghép</option>
                            </select>
                            <label>Loại phòng <span>*</span></label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Nội dung tin đăng -->
            <div class="custom-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="card-title mb-0">Nội dung tin đăng</h2>
                </div>

                <div class="form-group mb-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="fw-medium text-dark" style="font-size: 15px;">Hình ảnh/Video <span
                                class="text-danger">*</span></span>
                        <i class="bi bi-info-circle text-dark"></i>
                    </div>

                    <div class="upload-area" id="uploadArea">
                        <input type="file" name="images" id="fileInput" multiple accept="image/*,video/*" required>
                        <div class="upload-content">
                            <i class="bi bi-images upload-icon"></i>
                            <div class="upload-text">Thêm ảnh/video</div>
                        </div>
                    </div>
                    <div class="error-msg mt-2" style="display: block;">Vui lòng tải lên ít nhất 3 hình ảnh</div>
                </div>

                <div class="form-group floating-label">
                    <input type="text" class="custom-input" name="title" required maxlength="70" placeholder=" ">
                    <label>Tiêu đề tin đăng <span>*</span></label>
                    <div class="char-count">0/70 kí tự</div>
                </div>

                <div class="form-group floating-label">
                    <div class="input-with-suffix">
                        <input type="number" class="custom-input" name="price" required placeholder=" ">
                        <label>Giá thuê <span>*</span></label>
                        <span class="suffix">đ</span>
                    </div>
                </div>

                <div class="form-group floating-label">
                    <div class="input-with-suffix">
                        <input type="number" class="custom-input" name="deposit" placeholder=" ">
                        <label>Số tiền cọc</label>
                        <span class="suffix">đ</span>
                    </div>
                </div>

                <div class="form-group floating-label">
                    <textarea class="custom-input" name="description" rows="5" required maxlength="1500"
                        placeholder=" "></textarea>
                    <label>Mô tả <span>*</span></label>
                    <div class="char-count">0/1500 kí tự</div>
                </div>


            </div>

            <!-- Sticky Bottom Bar -->
            <div class="action-bar">
                <div class="wrapper d-flex gap-3 py-3" style="margin: 0 auto;">
                    <button type="button" class="btn-preview flex-fill">Xem trước</button>
                    <button type="submit" class="btn-submit flex-fill">Đăng tin</button>
                </div>
            </div>

        </form>
    </div>

    <script>
        // Upload box logic
        const fileInput = document.getElementById('fileInput');
        const uploadArea = document.getElementById('uploadArea');
        const uploadContent = document.querySelector('.upload-content');

        uploadArea.addEventListener('click', function () {
            fileInput.click();
        });

        fileInput.addEventListener('change', function () {
            if (this.files && this.files.length > 0) {
                uploadContent.innerHTML = `<i class="bi bi-check-circle-fill text-success" style="font-size: 32px; display: block; margin-bottom: 8px;"></i>
                                           <div class="upload-text text-success">Đã chọn ${this.files.length} file</div>`;
                uploadArea.style.borderColor = '#198754';
                uploadArea.style.backgroundColor = '#d1e7dd';
            } else {
                uploadContent.innerHTML = `<i class="bi bi-images upload-icon"></i>
                                           <div class="upload-text">Thêm ảnh/video</div>`;
                uploadArea.style.borderColor = '#e5002d';
                uploadArea.style.backgroundColor = '#fff9e6';
            }
        });
        // Floating label behavior
        document.querySelectorAll('.custom-input').forEach(input => {
            // Check initial state
            if (input.value) input.classList.add('has-value');

            input.addEventListener('input', function () {
                if (this.value) {
                    this.classList.add('has-value');
                } else {
                    this.classList.remove('has-value');
                }
            });
        });
    </script>
</body>

</html>