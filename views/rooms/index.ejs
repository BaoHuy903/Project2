<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>
    <%= title || 'Trang chủ' %>
  </title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/rooms/index.css">
</head>

<body>

  <!-- Top Navbar -->
  <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom" style="position: relative; z-index: 1030;">
    <div class="container-fluid px-4">
      <a class="navbar-brand d-flex align-items-center" href="/rooms">
        <i class="bi bi-house-door-fill fs-3 me-2"></i> TRỌ VÍP
      </a>

      <div class="search-bar d-none d-md-block">
        <i class="bi bi-search"></i>
        <input type="text" class="form-control" placeholder="Tìm kiếm... ">
      </div>

      <div class="ms-auto d-flex align-items-center">
        <!-- Nút Yêu thích -->
        <a href="#" class="btn btn-light rounded-circle me-3 d-flex justify-content-center align-items-center"
          style="width: 40px; height: 40px;" title="Tin đã lưu">
          <i class="bi bi-heart fs-5"></i>
        </a>

        <% if (user && user.role==='admin' ) { %>
          <a href="/rooms/add"
            class="btn btn-outline-warning text-dark border-warning btn-sm rounded-pill px-3 fw-bold me-3"
            style="background-color: #fff4e6;">
            <i class="bi bi-pencil-square text-warning"></i> Đăng tin
          </a>
          <% } %>
            <div class="dropdown">
              <button class="btn btn-light rounded-pill dropdown-toggle border-0" type="button"
                data-bs-toggle="dropdown">
                <i class="bi bi-person-circle fs-5 me-1 text-secondary align-middle"></i>
                <span class="fw-medium">
                  <%= user ? user.username : 'Khách' %>
                </span>
              </button>
              <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2">
                <li>
                  <hr class="dropdown-divider">
                </li>
                <li><a class="dropdown-item text-danger" href="/users/logout"><i class="bi bi-box-arrow-right me-2"></i>
                    Đăng xuất</a></li>
              </ul>
            </div>
      </div>
    </div>
  </nav>

  <!-- Horizontal Filter Bar -->
  <div class="filter-bar sticky-top" style="z-index: 1020;">
    <div class="container-fluid px-4 d-flex overflow-auto py-1">
      <button class="filter-btn fw-bold" style="background-color: #343a40; color: white; border-color: #343a40;">
        <i class="bi bi-filter"></i> Lọc
      </button>
      <button class="filter-btn">Loại phòng <i class="bi bi-chevron-down ms-1"></i></button>
      <button class="filter-btn">Địa điểm <i class="bi bi-x ms-1 text-muted"></i></button>
      <button class="filter-btn">Giá thuê <i class="bi bi-chevron-down ms-1"></i></button>
      <button class="filter-btn">Diện tích <i class="bi bi-chevron-down ms-1"></i></button>
      <button class="filter-btn">Tình trạng nội thất <i class="bi bi-chevron-down ms-1"></i></button>
    </div>
  </div>

  <div class="container-fluid px-4 py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
      <ol class="breadcrumb" style="font-size: 0.85rem;">
        <li class="breadcrumb-item"><a href="#" class="text-decoration-none text-muted">Trọ Víp</a></li>
      </ol>
    </nav>

    <div class="row">
      <!-- Left Column: Main List Placeholder -->
      <div class="col-lg-9">
        <!-- Nav tabs for filter -->
        <ul class="nav nav-pills mb-4 pb-2">
          <li class="nav-item me-2">
            <a class="nav-link active rounded-pill px-4 fw-medium border shadow-sm" href="#"
              style="background-color: #fff; color: #212529; border-color: #e9ecef;">Tất cả</a>
          </li>
          <li class="nav-item me-2">
            <a class="nav-link rounded-pill px-4 fw-medium border text-muted bg-white" href="#">Cá nhân</a>
          </li>
          <li class="nav-item">
            <a class="nav-link rounded-pill px-4 fw-medium border text-muted bg-white" href="#">Ở ghép</a>
          </li>
        </ul>

        <% if (typeof rooms !== 'undefined' && rooms.length > 0) { %>
          <% rooms.forEach(room => { %>
            <div class="room-card">
              <div style="position: relative;">
                <img src="<%= room.images && room.images.length > 0 ? room.images[0] : 'https://via.placeholder.com/140' %>" alt="Room image" class="room-image">
                <span class="room-badge" style="bottom: 8px; left: 8px; right: auto;">Tin ưu tiên</span>
                <span class="room-badge"><i class="bi bi-image"></i> <%= room.images ? room.images.length : 0 %></span>
              </div>
              <div class="room-info">
                <a href="#" class="room-title">
                  <span class="partner-badge"><i class="bi bi-shield-check"></i> Đối Tác</span>
                  <span class="hot-icon">🔥</span>
                  <%= room.title %>
                </a>
                <div class="room-meta"><%= room.category || 'Nội thất cơ bản' %></div>
                <div class="room-price-area">
                  <span class="price-text"><%= room.price ? (room.price / 1000000).toLocaleString('vi-VN') : 0 %> triệu/tháng</span>
                  <span class="area-text"><%= room.area || 0 %> m²</span>
                </div>
                <div class="room-address">
                  <i class="bi bi-geo-alt"></i> <%= room.address %>
                </div>
                <div class="room-footer">
                  <div class="poster-info">
                    <div class="poster-avatar"><%= room.host && room.host.username ? room.host.username.charAt(0).toUpperCase() : 'N' %></div>
                    <span><%= room.host && room.host.username ? room.host.username : 'Ẩn danh' %></span>
                    <span><i class="bi bi-bag"></i> <%= Math.floor(Math.random() * 10) + 1 %> tin đăng</span>
                  </div>
                  <button class="heart-btn"><i class="bi bi-heart"></i></button>
                </div>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="content-placeholder shadow-sm">
            <i class="bi bi-grid-3x3-gap"></i>
            <h5 class="fw-bold text-dark">Khu vực hiển thị danh sách phòng</h5>
            <p class="mb-0">Danh sách các phòng trọ sẽ được liệt kê ở đây.<br>(Chưa có dữ liệu phòng nào)</p>
          </div>
        <% } %>
      </div>

      <!-- Right Column: Sidebar Filters -->
      <div class="col-lg-3">

        <div class="sidebar-widget">
          <h5>Lọc theo khoảng giá <i class="bi bi-chevron-up"></i></h5>
          <ul class="filter-list">
            <li><a href="#">Giá dưới 1 triệu</a></li>
            <li><a href="#">Giá 1 - 2 triệu</a></li>
            <li><a href="#">Giá 2 - 3 triệu</a></li>
            <li><a href="#">Giá 3 - 5 triệu</a></li>
            <li><a href="#" class="text-secondary mt-3">Xem thêm <i class="bi bi-chevron-down"></i></a></li>
          </ul>
        </div>


        <div class="sidebar-widget">
          <h5>Lọc theo tình trạng nội thất <i class="bi bi-chevron-up"></i></h5>
          <ul class="filter-list border-bottom pb-2">
            <li><a href="#">Nội thất cơ bản</a></li>
            <li><a href="#">Nội thất đầy đủ</a></li>
            <li><a href="#">Nhà trống</a></li>
          </ul>
        </div>

      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>